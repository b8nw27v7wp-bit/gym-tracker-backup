.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #f1f2f4;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 24rpx rgba(17, 24, 39, 0.04);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 14rpx;
  position: relative;
}

.tab-indicator {
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: transparent;
  margin-bottom: 14rpx;
  transition: background 0.2s;
}

.tab-active .tab-indicator {
  background: #1d1d1f;
}

.tab-text {
  font-size: 30rpx;
  color: #9ca3af;
  font-weight: 400;
  letter-spacing: 2rpx;
  line-height: 1;
  transition: color 0.2s;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Noto Sans SC", sans-serif;
}

.tab-active .tab-text {
  color: #1d1d1f;
  font-weight: 600;
}
