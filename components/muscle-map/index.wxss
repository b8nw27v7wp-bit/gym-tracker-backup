/* 肌肉发力图组件（v3.0）— 浅色极简，渐变填充 + 改进配色 */
.mm-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mm-canvas {
  width: 100%;
  height: 420rpx;
}

.mm-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  gap: 24rpx;
}

.mm-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.mm-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 5rpx;
}

.mm-dot-primary {
  background: linear-gradient(135deg, #6366f1, #4338ca);
  box-shadow: 0 2rpx 6rpx rgba(79, 70, 229, 0.3);
}

.mm-dot-secondary {
  background: linear-gradient(135deg, #e0e7ff, #c7d2fe);
  border: 1rpx solid #a5b4fc;
}

.mm-legend-text {
  font-size: 22rpx;
  color: #6b7280;
  font-weight: 500;
}
