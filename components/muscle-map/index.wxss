/* 肌肉发力图组件（v3.5）— 解剖轮廓风格，红色渐变 */
.mm-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mm-canvas {
  width: 100%;
  height: 440rpx;
}

.mm-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  gap: 32rpx;
}

.mm-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.mm-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 5rpx;
}

.mm-dot-primary {
  background: linear-gradient(135deg, #dc2626, #f97316);
  box-shadow: 0 2rpx 8rpx rgba(220, 38, 38, 0.4);
}

.mm-dot-secondary {
  background: linear-gradient(135deg, #fca5a5, #fecaca);
  border: 1rpx solid #f87171;
}

.mm-legend-text {
  font-size: 22rpx;
  color: #6b7280;
  font-weight: 500;
}
