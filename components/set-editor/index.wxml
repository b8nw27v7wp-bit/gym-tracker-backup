<view class="card">
  <view class="edit-head">
    <text class="card-title">{{exerciseName}}</text>
    <view class="edit-head-right">
      <text class="tag" style="margin:0;">{{muscleName}}</text>
      <view class="edit-close" bindtap="onClose">
        <view class="icon icon-x"></view>
      </view>
    </view>
  </view>
  <view class="set-head">
    <text class="set-col set-c-no">组</text>
    <text class="set-col set-c-warm">热</text>
    <text class="set-col set-c-w">{{bodyweight ? '自重' : '重量(' + unit + ')'}}</text>
    <text class="set-col set-c-x"></text>
    <text class="set-col set-c-r">次数</text>
    <text class="set-col set-c-rpe">RPE</text>
    <text class="set-col set-c-del"></text>
  </view>
  <view wx:for="{{sets}}" wx:key="uid" class="set-row">
    <text class="set-col set-c-no set-no">{{index + 1}}</text>
    <view
      class="set-col set-c-warm warm-btn {{item.warmup ? 'warm-on' : ''}}"
      data-idx="{{index}}"
      bindtap="onToggleWarmup"
    >{{item.warmup ? 'W' : '·'}}</view>
    <input
      wx:if="{{!bodyweight}}"
      class="set-col set-c-w set-input"
      type="digit"
      value="{{item.weight}}"
      data-idx="{{index}}"
      bindinput="onWeightInput"
      placeholder="0"
    />
    <text wx:else class="set-col set-c-w set-bodyweight">自重</text>
    <text class="set-col set-c-x set-x">×</text>
    <input
      class="set-col set-c-r set-input"
      type="number"
      value="{{item.reps}}"
      data-idx="{{index}}"
      bindinput="onRepsInput"
      placeholder="0"
    />
    <input
      class="set-col set-c-rpe set-input set-input-rpe"
      type="number"
      value="{{item.rpe}}"
      data-idx="{{index}}"
      bindinput="onRpeInput"
      placeholder="—"
    />
    <view class="set-col set-c-del set-del" data-idx="{{index}}" bindtap="onRemoveSet">
      <view class="icon icon-x"></view>
    </view>
  </view>
  <view class="set-tip" wx:if="{{lastPrefill}}">
    <text class="prefill-text">{{lastPrefill}}</text>
    <text class="prefill-clear" catchtap="onClearPrefill">清空预填</text>
  </view>
  <view class="set-tip" wx:else>热 = 热身组（不计入容量统计）· RPE 选填（1-10 自感强度）</view>
  <view class="btn-ghost btn-ghost-add" bindtap="onAddSet">
    <view class="icon icon-plus"></view>
    <text>添加一组</text>
  </view>
  <view class="btn-primary" style="margin-top: 20rpx;" bindtap="onDone">完成该动作</view>
</view>
