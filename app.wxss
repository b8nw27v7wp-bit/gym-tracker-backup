/* 浅色极简主题：白底、无边框卡片、大留白 */
/* 全局 Apple 系统字体栈：iOS=SF Pro+苹方，Android=Roboto，去 AI 感 */
page {
  background: #f7f7f8;
  color: #1d1d1f;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display",
    "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  letter-spacing: 0.2rpx;
}

/* 数字统一等宽数字特性（金额/容量/计数对齐） */
.num, .num-accent, .big-num {
  font-variant-numeric: tabular-nums;
}

/* 卡片：白底 + 大圆角 + 轻投影，无边框 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx 32rpx;
  box-shadow: 0 1rpx 3rpx rgba(17, 24, 39, 0.04), 0 8rpx 24rpx rgba(17, 24, 39, 0.03);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 16rpx;
  letter-spacing: 0.5rpx;
}

.card-sub {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 主按钮：黑底白字 */
.btn-primary {
  background: #1d1d1f;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 24rpx 0;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary[disabled] {
  background: #e5e7eb;
  color: #9ca3af;
}

/* 次按钮：浅灰 */
.btn-ghost {
  background: #f3f4f6;
  color: #374151;
  border-radius: 16rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
  text-align: center;
}

.btn-ghost:active {
  opacity: 0.85;
}

/* 标签 */
.tag {
  display: inline-block;
  background: #f3f4f6;
  color: #374151;
  border-radius: 12rpx;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.tag-active {
  background: #1d1d1f;
  color: #ffffff;
}

/* 空态 */
.empty {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 120rpx 40rpx;
}

.empty-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #6b7280;
}

.empty-sub {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 12rpx;
}

/* 数字强调 */
.num {
  font-weight: 600;
  color: #1d1d1f;
}

.num-accent {
  font-weight: 700;
  color: #1d1d1f;
}

/* 删除按钮文字 */
.danger {
  color: #ef4444;
}
