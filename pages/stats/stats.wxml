<view class="page">
  <!-- 个人中心入口 + 预览小窗 -->
  <view class="profile-card" bindtap="onOpenProfile">
    <view class="profile-left">
      <view class="profile-avatar-wrap">
        <image wx:if="{{wxUser.avatarUrl}}" class="profile-avatar" src="{{wxUser.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="profile-avatar-placeholder">{{wxUser.nickName ? wxUser.nickName[0] : '?'}}</view>
      </view>
      <view class="profile-info">
        <text class="profile-name">{{wxUser.nickName || '点击登录'}}</text>
        <text class="profile-desc" wx:if="{{wxUser}}">已登录</text>
        <text class="profile-desc" wx:else>设置头像和昵称</text>
      </view>
    </view>
    <view class="profile-right">
      <view class="profile-stats" wx:if="{{hasData}}">
        <view class="profile-stat">
          <text class="profile-stat-num">{{totalCount}}</text>
          <text class="profile-stat-label">训练</text>
        </view>
        <view class="profile-stat-divider"></view>
        <view class="profile-stat">
          <text class="profile-stat-num">{{heatDays}}</text>
          <text class="profile-stat-label">活跃天</text>
        </view>
      </view>
      <text class="profile-arrow">›</text>
    </view>
  </view>

  <!-- 本周简报 -->
  <view class="card" wx:if="{{hasData}}">
    <view class="card-title">本周简报</view>
    <view class="brief-row">
      <view class="brief-item">
        <text class="brief-num">{{weekCount}}</text>
        <text class="brief-label">训练次数</text>
      </view>
      <view class="brief-item">
        <text class="brief-num">{{weekVolume}}</text>
        <text class="brief-label">容量 {{unitLabel}}</text>
      </view>
      <view class="brief-item">
        <text class="brief-num">{{prBreakCount}}</text>
        <text class="brief-label">打破纪录</text>
      </view>
      <view class="brief-item" wx:if="{{bodyDeltaText}}">
        <text class="brief-num {{bodyDeltaClass}}">{{bodyDeltaText}}</text>
        <text class="brief-label">体重变化</text>
      </view>
    </view>
  </view>

  <!-- 连续打卡 + 成就（v5） -->
  <view class="card" wx:if="{{hasData && streak}}">
    <view class="heat-head">
      <view class="card-title" style="margin:0;">连续打卡</view>
      <text class="heat-days">最长连续 {{streak.longest}} 天</text>
    </view>
    <view class="streak-row">
      <view class="streak-item">
        <text class="streak-num">{{streak.current}}</text>
        <text class="streak-label">当前连续（天）</text>
      </view>
      <view class="streak-divider"></view>
      <view class="streak-item">
        <text class="streak-num">{{achievementUnlocked}}</text>
        <text class="streak-label">已解锁成就</text>
      </view>
      <view class="streak-divider"></view>
      <view class="streak-item">
        <text class="streak-num">{{totalCount}}</text>
        <text class="streak-label">累计训练</text>
      </view>
    </view>
    <view class="ach-grid">
      <view wx:for="{{achievements}}" wx:key="key" class="ach-item {{item.unlocked ? 'ach-on' : ''}}">
        <text class="ach-dot {{item.unlocked ? 'ach-dot-on' : ''}}"></text>
        <view class="ach-info">
          <text class="ach-name">{{item.name}}</text>
          <text class="ach-desc">{{item.desc}} · {{item.progress}}/{{item.target}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 训练目标（v5） -->
  <view class="card" wx:if="{{goals && goals.hasGoals}}">
    <view class="goal-head">
      <view class="card-title" style="margin:0;">训练目标</view>
      <text class="goal-edit" bindtap="onOpenGoals">编辑</text>
    </view>
    <!-- 体重目标 -->
    <view wx:if="{{goals.bodyweight}}" class="goal-progress-block">
      <view class="goal-progress-head">
        <text class="goal-progress-name">体重目标</text>
        <text class="goal-progress-val">{{goals.bodyweight.current}} → {{goals.bodyweight.target}} {{unitLabel}}</text>
      </view>
      <view class="goal-track">
        <view class="goal-fill {{goals.bodyweight.progress >= 100 ? 'goal-fill-done' : ''}}" style="width: {{goals.bodyweight.progress >= 100 ? 100 : goals.bodyweight.progress}}%;"></view>
      </view>
      <text class="goal-progress-pct">{{goals.bodyweight.progress >= 100 ? 100 : goals.bodyweight.progress}}%</text>
    </view>
    <!-- 力量目标 -->
    <view wx:for="{{goals.strength}}" wx:key="exerciseId" class="goal-progress-block">
      <view class="goal-progress-head">
        <text class="goal-progress-name">{{item.name}}</text>
        <text class="goal-progress-val">{{item.current}} / {{item.target}} {{unitLabel}}</text>
      </view>
      <view class="goal-track">
        <view class="goal-fill {{item.done ? 'goal-fill-done' : ''}}" style="width: {{item.progress}}%;"></view>
      </view>
      <text class="goal-progress-pct">{{item.progress}}%</text>
    </view>
    <view class="goal-advice" wx:if="{{goals.advice.length > 0}}">
      <text wx:for="{{goals.advice}}" wx:key="*this" class="goal-advice-line">{{item}}</text>
    </view>
  </view>

  <!-- 每日热量 -->
  <view class="card cal-card" wx:if="{{calHas}}">
    <view class="cal-head">
      <view class="card-title" style="margin:0;">每日热量</view>
      <text class="cal-edit" bindtap="onOpenCalculator">修改资料</text>
    </view>
    <view class="cal-grid">
      <view class="cal-item">
        <text class="cal-num">{{calBmr}}</text>
        <text class="cal-label">基础代谢</text>
      </view>
      <view class="cal-item">
        <text class="cal-num cal-accent">{{calTdee}}</text>
        <text class="cal-label">每日消耗</text>
      </view>
      <view class="cal-item">
        <text class="cal-num">{{calWeekKcal}}</text>
        <text class="cal-label">本周运动消耗</text>
      </view>
    </view>
    <view class="cal-bar">
      <view class="cal-suggest">
        <text class="cal-suggest-label">减脂建议</text>
        <text class="cal-suggest-num">{{calCut}}</text>
      </view>
      <view class="cal-divider"></view>
      <view class="cal-suggest">
        <text class="cal-suggest-label">维持</text>
        <text class="cal-suggest-num">{{calTdee}}</text>
      </view>
      <view class="cal-divider"></view>
      <view class="cal-suggest">
        <text class="cal-suggest-label">增肌建议</text>
        <text class="cal-suggest-num">{{calBulk}}</text>
      </view>
    </view>
    <view class="cal-tip">Mifflin-St Jeor 估算 · 运动消耗按 MET × 体重 × 时长估算</view>
    <!-- 摄入 vs 消耗 -->
    <view class="cal-intake">
      <view class="cal-intake-item">
        <text class="cal-intake-label">今日摄入</text>
        <text class="cal-intake-num">{{calIntake}}</text>
      </view>
      <view class="cal-intake-item">
        <text class="cal-intake-label">今日可吃</text>
        <text class="cal-intake-num">{{calBudget}}</text>
      </view>
      <view class="cal-intake-item">
        <text class="cal-intake-label {{calGap >= 0 ? 'gap-ok' : 'gap-over'}}">{{calGap >= 0 ? '还可吃' : '已超支'}}</text>
        <text class="cal-intake-num {{calGap >= 0 ? 'gap-ok' : 'gap-over'}}">{{calGapText}}</text>
      </view>
      <view class="cal-intake-btn" bindtap="onOpenFood">记饮食</view>
    </view>
  </view>

  <!-- 热量未设置引导 -->
  <view class="card cal-card" wx:else>
    <view class="cal-head">
      <view class="card-title" style="margin:0;">每日热量</view>
    </view>
    <view class="cal-empty">
      <text class="cal-empty-text">设置身体资料后，查看基础代谢、每日消耗与训练消耗热量</text>
      <view class="btn-primary cal-empty-btn" bindtap="onOpenCalculator">去设置</view>
    </view>
  </view>

  <!-- 本周概览 -->
  <view class="card hero-card">
    <view class="card-sub">本周训练容量</view>
    <view class="big-num">{{weekVolume}} <text class="big-unit">{{unitLabel}}</text></view>
    <view class="delta {{deltaClass}}">{{deltaText}}</view>
  </view>

  <!-- 训练周报（Batch3）：最近 8 周每周总结，左右切换回看 -->
  <view class="card">
    <view class="weekly-head">
      <view class="card-title" style="margin:0;">训练周报</view>
      <view wx:if="{{weeklyReport.hasData}}" class="weekly-share" bindtap="onWeeklyShare">分享</view>
    </view>
    <view class="weekly-nav">
      <view class="weekly-arrow {{weeklyIndex === 0 ? 'weekly-arrow-dis' : ''}}" bindtap="onWeekPrev" hover-class="weekly-arrow-hover">‹</view>
      <text class="weekly-label">{{weeklyReport.label}}</text>
      <view class="weekly-arrow {{weeklyIndex >= weeklyReportCount - 1 ? 'weekly-arrow-dis' : ''}}" bindtap="onWeekNext" hover-class="weekly-arrow-hover">›</view>
    </view>
    <view wx:if="{{weeklyReport.hasData}}">
      <view class="weekly-hero">{{weeklyReport.workouts}} 次训练 · {{weeklyReport.volume}} {{unitLabel}} · {{weeklyReport.duration}} 分钟</view>
      <view class="weekly-delta {{weeklyReport.deltaClass}}">{{weeklyReport.deltaText}}</view>
      <view class="weekly-detail">
        <view class="weekly-detail-item" wx:if="{{weeklyReport.prs > 0}}">
          <text class="weekly-detail-num">{{weeklyReport.prs}}</text>
          <text class="weekly-detail-label">新 PR</text>
        </view>
        <view class="weekly-detail-item">
          <text class="weekly-detail-num">{{weeklyReport.groups}}</text>
          <text class="weekly-detail-label">覆盖肌群</text>
        </view>
        <view class="weekly-detail-item">
          <text class="weekly-detail-num">{{weeklyReport.streak}}</text>
          <text class="weekly-detail-label">连续训练（天）</text>
        </view>
        <view class="weekly-detail-item">
          <text class="weekly-detail-num">{{weeklyReport.sets}}</text>
          <text class="weekly-detail-label">总组数</text>
        </view>
      </view>
      <view wx:if="{{weeklyReport.newPRs.length > 0}}" class="weekly-pr" bindtap="onWeeklyPrTap" hover-class="weekly-pr-hover">
        <view class="weekly-pr-row">
          <text class="weekly-pr-label">新纪录</text>
          <text class="weekly-pr-more">查看历史 ›</text>
        </view>
        <view class="weekly-pr-chips">
          <view wx:for="{{weeklyReport.newPRs}}" wx:key="name" class="weekly-pr-chip">{{item.name}} {{item.weight}} {{unitLabel}}</view>
        </view>
      </view>
      <view class="weekly-groups" wx:if="{{weeklyReport.groupsCovered.length > 0}}">
        <text class="weekly-groups-label">肌群</text>
        <text wx:for="{{weeklyReport.groupsCovered}}" wx:key="*this" class="cov-chip">{{item}}</text>
      </view>
    </view>
    <view wx:else class="weekly-empty">
      <text>本周未训练</text>
    </view>
  </view>

  <!-- 训练频率 -->
  <view class="card" wx:if="{{hasData}}">
    <view class="card-title">训练频率</view>
    <view class="freq-row">
      <view class="freq-item">
        <text class="freq-num">{{weekCount}}</text>
        <text class="freq-label">本周训练</text>
      </view>
      <view class="freq-divider"></view>
      <view class="freq-item">
        <text class="freq-num">{{totalCount}}</text>
        <text class="freq-label">累计训练</text>
      </view>
      <view class="freq-divider"></view>
      <view class="freq-item">
        <text class="freq-num">{{avgPerWeek}}</text>
        <text class="freq-label">周均次数</text>
      </view>
      <view class="freq-divider"></view>
      <view class="freq-item">
        <text class="freq-num">{{coveredCount}}</text>
        <text class="freq-label">本周部位</text>
      </view>
    </view>
    <view class="coverage-bar">
      <view wx:for="{{coveredMuscles}}" wx:key="*this" class="cov-chip">{{item}}</view>
      <text wx:if="{{coveredCount === 0}}" class="cov-empty">本周还没有训练</text>
    </view>
  </view>

  <!-- 近 8 周容量（canvas 图） -->
  <view class="card" wx:if="{{hasData}}">
    <view class="card-title">近 8 周容量</view>
    <canvas type="2d" id="volCanvas" class="chart-canvas"></canvas>
    <!-- 训练智能：减量周 / 冲 PR 提示 -->
    <view wx:if="{{deloadTip}}" class="deload-tip deload-{{deloadTrend}}">{{deloadTip}}</view>
  </view>

  <!-- 训练热力图 -->
  <view class="card" wx:if="{{hasData}}">
    <view class="heat-head">
      <view class="card-title">训练热力图</view>
      <text class="heat-days">近 12 周训练 {{heatDays}} 天</text>
    </view>
    <scroll-view scroll-x class="heat-scroll" enable-flex>
      <view class="heat-grid">
        <view class="heat-week" wx:for="{{heatWeeks}}" wx:key="weekStart" wx:for-item="wk">
          <text class="heat-week-label" wx:if="{{index % 4 === 0}}">{{wk.label}}</text>
          <text class="heat-week-label heat-label-spacer" wx:else> </text>
          <view class="heat-days-col">
            <view wx:for="{{wk.days}}" wx:key="ts" wx:for-item="d"
                  class="heat-cell heat-l{{d.level}}"
                  hover-class="heat-cell-hover"></view>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="heat-legend">
      <text class="heat-legend-text">少</text>
      <view class="heat-cell heat-l0 legend-cell"></view>
      <view class="heat-cell heat-l1 legend-cell"></view>
      <view class="heat-cell heat-l2 legend-cell"></view>
      <view class="heat-cell heat-l3 legend-cell"></view>
      <view class="heat-cell heat-l4 legend-cell"></view>
      <text class="heat-legend-text">多</text>
    </view>
  </view>

  <!-- 部位热力图（GitHub 风格肌群矩阵：行=肌群，列=近 12 周，色深=当周组数） -->
  <view class="card">
    <view class="heat-head">
      <view class="card-title">部位热力图</view>
      <text class="heat-days" wx:if="{{heatHasData}}">近 12 周训练 {{heatTotalSets}} 组</text>
      <text class="heat-days" wx:else>近 12 周肌群训练量</text>
    </view>
    <view wx:if="{{heatHasData}}">
      <view class="gh-head">
        <view class="gh-head-name">部位</view>
        <view class="gh-head-cells">
          <text wx:for="{{heatWeekLabels}}" wx:key="index" class="gh-head-label">{{item}}</text>
        </view>
      </view>
      <view wx:for="{{heatRows}}" wx:key="key"
            class="gh-row {{heatSelected && heatSelected.key === item.key ? 'gh-row-active' : ''}}"
            data-key="{{item.key}}" bindtap="onGroupTap" hover-class="gh-row-hover">
        <text class="gh-row-name">{{item.name}}</text>
        <view class="gh-row-cells">
          <view wx:for="{{item.cells}}" wx:for-item="c" wx:key="index" class="gh-cell heat-l{{c.level}}"></view>
        </view>
        <text class="gh-row-total">{{item.total}}</text>
      </view>
      <!-- 常驻信息区：未选中=引导（避免布局跳动），选中=肌群数据 + 档位色块 -->
      <view class="heat-selected" wx:if="{{heatSelected}}">
        <view class="heat-selected-dot heat-l{{heatSelected.level}}"></view>
        <text class="heat-selected-name">{{heatSelected.name}}</text>
        <text class="heat-selected-val" wx:if="{{heatSelected.sets > 0}}">近 12 周 {{heatSelected.sets}} 组 · {{heatSelected.sessions}} 次训练 · 占全身 {{heatSelected.share}}%</text>
        <text class="heat-selected-val" wx:else>近 12 周未训练</text>
      </view>
      <view class="heat-selected" wx:else>
        <text class="heat-selected-hint">点击部位行，查看近 12 周训练量</text>
      </view>
      <view class="heat-legend heat-legend-mid">
        <text class="heat-legend-text">未练</text>
        <view class="heat-cell heat-l0 legend-cell"></view>
        <view class="heat-cell heat-l1 legend-cell"></view>
        <view class="heat-cell heat-l2 legend-cell"></view>
        <view class="heat-cell heat-l3 legend-cell"></view>
        <view class="heat-cell heat-l4 legend-cell"></view>
        <text class="heat-legend-text">多</text>
      </view>
      <view class="heat-tip">每格 = 该部位当周训练组数 · 颜色越深训练越多</view>
    </view>
    <view wx:else class="heat-empty">
      <text class="heat-empty-text">开始训练后生成部位热力图</text>
    </view>
  </view>

  <!-- 肌肉恢复建议（v5）：本周每肌群组数 vs 建议范围 -->
  <view class="card" wx:if="{{recovery && hasData}}">
    <view class="heat-head">
      <view class="card-title" style="margin:0;">肌肉恢复</view>
      <text class="heat-days">本周各部位组数 vs 建议范围</text>
    </view>
    <view wx:for="{{recovery.rows}}" wx:key="key" class="rec-row">
      <text class="rec-name">{{item.name}}</text>
      <view class="rec-track">
        <view class="rec-fill rec-{{item.status}}" style="width: {{item.pct}}%;"></view>
      </view>
      <text class="rec-val">{{item.sets}}<text wx:if="{{item.max > 0}}" class="rec-range"> / {{item.max}}</text></text>
    </view>
    <view class="rec-tips" wx:if="{{recovery.tips.length > 0}}">
      <view wx:for="{{recovery.tips}}" wx:key="*this" class="rec-tip">{{item}}</view>
    </view>
    <view class="rec-legend">
      <view class="rec-legend-item"><view class="rec-dot rec-low"></view><text>欠练</text></view>
      <view class="rec-legend-item"><view class="rec-dot rec-ok"></view><text>正常</text></view>
      <view class="rec-legend-item"><view class="rec-dot rec-high"></view><text>超练</text></view>
    </view>
  </view>

  <!-- 身体围度摘要（v5） -->
  <view class="card" wx:if="{{measurementSummary.length > 0}}">
    <view class="bw-head">
      <view>
        <view class="card-title" style="margin-bottom: 4rpx;">身体围度</view>
        <view class="bw-summary">胸/腰/臂/腿围追踪，看体型变化</view>
      </view>
      <view class="bw-add" bindtap="onOpenMeasurements">＋ 记录</view>
    </view>
    <view class="ms-grid">
      <view wx:for="{{measurementSummary}}" wx:key="key" class="ms-cell">
        <text class="ms-cell-name">{{item.name}}</text>
        <text class="ms-cell-val">{{item.latest}} cm</text>
        <text class="ms-cell-delta {{item.deltaUp ? 'ms-cell-up' : 'ms-cell-down'}}">{{item.delta > 0 ? '+' : ''}}{{item.delta}}</text>
      </view>
    </view>
    <view class="ms-more" bindtap="onOpenMeasurements">查看全部围度 ›</view>
  </view>

  <!-- 部位分布 -->
  <view class="card" wx:if="{{hasData}}">
    <view class="card-title">部位训练分布</view>
    <view wx:for="{{muscleDist}}" wx:key="key" class="dist-row">
      <text class="dist-name">{{item.icon}} {{item.name}}</text>
      <view class="dist-track">
        <view class="dist-fill" style="width: {{item.pct}}%;"></view>
      </view>
      <text class="dist-val">{{item.volume}} {{unitLabel}}</text>
    </view>
  </view>

  <!-- 个人纪录 -->
  <view class="card" wx:if="{{prs.length > 0}}">
    <view class="card-title">个人纪录 PR</view>
    <view wx:for="{{prs}}" wx:key="id" class="pr-row" hover-class="pr-row-hover"
          bindtap="onPrTrend" data-id="{{item.id}}">
      <view class="pr-left">
        <text class="pr-name">{{item.name}}</text>
        <text class="pr-date">{{item.dateText}}</text>
      </view>
      <view class="pr-right">
        <text class="pr-max">{{item.maxWeight}} <text class="pr-unit">{{unitLabel}}</text></text>
        <text class="pr-best">最佳单组 {{item.bestSet}} {{unitLabel}}<text wx:if="{{item.est1rm}}"> · 1RM≈{{item.est1rm}}</text></text>
        <!-- 训练智能：1RM 趋势预测 -->
        <text wx:if="{{item.predText}}" class="pr-predict">{{item.predText}}</text>
      </view>
      <!-- 1RM 迷你趋势 + 大图入口 -->
      <view class="pr-trend-wrap" wx:if="{{item.trend.length > 0}}">
        <view class="pr-trend">
          <view class="pr-trend-bar" wx:for="{{item.trend}}" wx:for-item="t" wx:key="label" style="height: {{t.height}}%;" title="{{t.est}}kg"></view>
        </view>
        <view class="pr-chart-link" wx:if="{{item.trend.length > 1}}">趋势</view>
      </view>
    </view>
  </view>

  <!-- 1RM 大图（modal） -->
  <view class="chart-mask" wx:if="{{chartVisible}}" bindtap="onCloseChart">
    <view class="chart-panel" catchtap="noop">
      <view class="chart-panel-head">
        <view>
          <view class="chart-panel-title">{{chartName}}</view>
          <view class="chart-panel-sub">估算 1RM 历史趋势 · 最新 {{chartEst}} kg</view>
        </view>
        <view class="chart-close" bindtap="onCloseChart">✕</view>
      </view>
      <canvas type="2d" id="rmCanvas" class="chart-canvas-lg"></canvas>
    </view>
  </view>

  <!-- 体重趋势 -->
  <view class="card" wx:if="{{hasBodyData}}">
    <view class="bw-head">
      <view>
        <view class="card-title" style="margin-bottom: 4rpx;">体重趋势</view>
        <view class="bw-summary">当前 {{bwLatest}} {{unitLabel}} · 累计 {{bwDeltaText}}</view>
      </view>
      <view class="bw-add" bindtap="onAddBodyweight">＋ 记录</view>
    </view>
    <view class="bars">
      <view wx:for="{{bwPoints}}" class="bar-col">
        <view class="bar-track">
          <view class="bar-fill bw-fill" style="height: {{item.height}}%;"></view>
        </view>
        <text class="bar-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 体重空态 -->
  <view class="card" wx:if="{{!hasBodyData && hasData}}">
    <view class="card-title">体重趋势</view>
    <view class="bw-empty">
      <text>记录体重，追踪增肌/减脂进度</text>
      <view class="btn-ghost bw-add-btn" bindtap="onAddBodyweight">＋ 记录体重</view>
    </view>
  </view>

  <!-- 月度总结 -->
  <view class="card" wx:if="{{hasData && monthly}}">
    <view class="card-title">本月总结</view>
    <view class="monthly-grid">
      <view class="monthly-item">
        <text class="monthly-num">{{monthly.count}}</text>
        <text class="monthly-label">训练次数</text>
      </view>
      <view class="monthly-item">
        <text class="monthly-num">{{monthly.totalVolume}}</text>
        <text class="monthly-label">总容量 {{unitLabel}}</text>
      </view>
      <view class="monthly-item">
        <text class="monthly-num">{{monthly.prCount}}</text>
        <text class="monthly-label">新 PR</text>
      </view>
      <view class="monthly-item">
        <text class="monthly-num">{{monthly.avgDensity}}</text>
        <text class="monthly-label">平均密度</text>
      </view>
    </view>
  </view>

  <!-- 肌群平衡分析 -->
  <view class="card" wx:if="{{balanceReady}}">
    <view class="card-title">肌群平衡分析</view>
    <view class="balance-chart">
      <view class="balance-bar">
        <view class="balance-fill push" style="width: {{balance.ratio.push}}%;"></view>
      </view>
      <view class="balance-labels">
        <view class="balance-label">
          <view class="balance-dot push"></view>
          <text>推 {{balance.ratio.push}}%</text>
        </view>
        <view class="balance-label">
          <view class="balance-dot pull"></view>
          <text>拉 {{balance.ratio.pull}}%</text>
        </view>
        <view class="balance-label">
          <view class="balance-dot legs"></view>
          <text>腿 {{balance.ratio.legs}}%</text>
        </view>
      </view>
    </view>
    <view class="balance-advice">{{balance.advice}}</view>
    <view class="balance-detail">
      <view class="balance-detail-item">
        <text class="balance-detail-label">推类容量</text>
        <text class="balance-detail-value">{{balance.push}} {{unitLabel}}</text>
      </view>
      <view class="balance-detail-item">
        <text class="balance-detail-label">拉类容量</text>
        <text class="balance-detail-value">{{balance.pull}} {{unitLabel}}</text>
      </view>
      <view class="balance-detail-item">
        <text class="balance-detail-label">腿部容量</text>
        <text class="balance-detail-value">{{balance.legs}} {{unitLabel}}</text>
      </view>
    </view>
  </view>

  <!-- 训练密度趋势 -->
  <view class="card" wx:if="{{hasData && density.length > 0}}">
    <view class="card-title">训练密度趋势</view>
    <view class="density-hint">容量/时长（kg/min），衡量训练效率</view>
    <view class="density-bars">
      <view wx:for="{{density}}" class="density-col">
        <view class="density-track">
          <view class="density-fill" style="height: {{item.density > 0 ? 50 : 0}}%;"></view>
        </view>
        <text class="density-label">{{item.date}}</text>
        <text class="density-value">{{item.density}}</text>
      </view>
    </view>
  </view>

  <!-- 周训练频率 -->
  <view class="card" wx:if="{{hasData && freqTrend.length > 0}}">
    <view class="card-title">周训练频率</view>
    <view class="freq-bars">
      <view wx:for="{{freqTrend}}" class="freq-col">
        <view class="freq-track">
          <view class="freq-fill" style="height: {{item.count * 20}}%;"></view>
        </view>
        <text class="freq-label">{{item.label}}</text>
        <text class="freq-value">{{item.count}}</text>
      </view>
    </view>
  </view>

  <!-- 周报分享卡 modal（canvas 2d 生成图片保存相册） -->
  <view class="chart-mask" wx:if="{{weeklyShareVisible}}" bindtap="onCloseWeeklyShare">
    <view class="chart-panel" catchtap="noop">
      <view class="chart-panel-head">
        <view>
          <view class="chart-panel-title">训练周报 · {{weeklyReport.label}}</view>
          <view class="chart-panel-sub">{{weeklyReport.workouts}} 次训练 · {{weeklyReport.volume}} {{unitLabel}} 容量</view>
        </view>
        <view class="chart-close" bindtap="onCloseWeeklyShare">✕</view>
      </view>
      <canvas type="2d" id="weeklyShareCanvas" class="chart-canvas-lg"></canvas>
      <view class="chart-save" bindtap="onSaveWeeklyShare">保存图片到相册</view>
    </view>
  </view>
</view>
