<view class="page">
  <!-- 本周简报 -->
  <view class="card" wx:if="{{hasData}}">
    <view class="card-title">本周简报</view>
    <view class="brief-row">
      <view class="brief-item">
        <text class="brief-num">{{weekCount}}</text>
        <text class="brief-label">训练次数</text>
      </view>
      <view class="brief-item">
        <text class="brief-num">{{weekVolume}}</text>
        <text class="brief-label">容量 kg</text>
      </view>
      <view class="brief-item">
        <text class="brief-num">{{prBreakCount}}</text>
        <text class="brief-label">打破纪录</text>
      </view>
      <view class="brief-item" wx:if="{{bodyDeltaText}}">
        <text class="brief-num {{bodyDeltaClass}}">{{bodyDeltaText}}</text>
        <text class="brief-label">体重变化</text>
      </view>
    </view>
  </view>

  <!-- 每日热量 -->
  <view class="card cal-card" wx:if="{{calHas}}">
    <view class="cal-head">
      <view class="card-title" style="margin:0;">每日热量</view>
      <text class="cal-edit" bindtap="onOpenCalculator">修改资料</text>
    </view>
    <view class="cal-grid">
      <view class="cal-item">
        <text class="cal-num">{{calBmr}}</text>
        <text class="cal-label">基础代谢</text>
      </view>
      <view class="cal-item">
        <text class="cal-num cal-accent">{{calTdee}}</text>
        <text class="cal-label">每日消耗</text>
      </view>
      <view class="cal-item">
        <text class="cal-num">{{calWeekKcal}}</text>
        <text class="cal-label">本周运动消耗</text>
      </view>
    </view>
    <view class="cal-bar">
      <view class="cal-suggest">
        <text class="cal-suggest-label">减脂建议</text>
        <text class="cal-suggest-num">{{calCut}}</text>
      </view>
      <view class="cal-divider"></view>
      <view class="cal-suggest">
        <text class="cal-suggest-label">维持</text>
        <text class="cal-suggest-num">{{calTdee}}</text>
      </view>
      <view class="cal-divider"></view>
      <view class="cal-suggest">
        <text class="cal-suggest-label">增肌建议</text>
        <text class="cal-suggest-num">{{calBulk}}</text>
      </view>
    </view>
    <view class="cal-tip">Mifflin-St Jeor 估算 · 运动消耗按 MET × 体重 × 时长估算</view>
  </view>

  <!-- 热量未设置引导 -->
  <view class="card cal-card" wx:else>
    <view class="cal-head">
      <view class="card-title" style="margin:0;">每日热量</view>
    </view>
    <view class="cal-empty">
      <text class="cal-empty-text">设置身体资料后，查看基础代谢、每日消耗与训练消耗热量</text>
      <view class="btn-primary cal-empty-btn" bindtap="onOpenCalculator">去设置</view>
    </view>
  </view>

  <!-- 本周概览 -->
  <view class="card hero-card">
    <view class="card-sub">本周训练容量</view>
    <view class="big-num">{{weekVolume}} <text class="big-unit">kg</text></view>
    <view class="delta {{deltaClass}}">{{deltaText}}</view>
  </view>

  <!-- 训练频率 -->
  <view class="card" wx:if="{{hasData}}">
    <view class="card-title">训练频率</view>
    <view class="freq-row">
      <view class="freq-item">
        <text class="freq-num">{{weekCount}}</text>
        <text class="freq-label">本周训练</text>
      </view>
      <view class="freq-divider"></view>
      <view class="freq-item">
        <text class="freq-num">{{totalCount}}</text>
        <text class="freq-label">累计训练</text>
      </view>
      <view class="freq-divider"></view>
      <view class="freq-item">
        <text class="freq-num">{{avgPerWeek}}</text>
        <text class="freq-label">周均次数</text>
      </view>
      <view class="freq-divider"></view>
      <view class="freq-item">
        <text class="freq-num">{{coveredCount}}</text>
        <text class="freq-label">本周部位</text>
      </view>
    </view>
    <view class="coverage-bar">
      <view wx:for="{{coveredMuscles}}" wx:key="*this" class="cov-chip">{{item}}</view>
      <text wx:if="{{coveredCount === 0}}" class="cov-empty">本周还没有训练</text>
    </view>
  </view>

  <!-- 近 8 周容量（canvas 图） -->
  <view class="card" wx:if="{{hasData}}">
    <view class="card-title">近 8 周容量</view>
    <canvas type="2d" id="volCanvas" class="chart-canvas"></canvas>
  </view>

  <!-- 训练热力图 -->
  <view class="card" wx:if="{{hasData}}">
    <view class="heat-head">
      <view class="card-title">训练热力图</view>
      <text class="heat-days">近 12 周训练 {{heatDays}} 天</text>
    </view>
    <scroll-view scroll-x class="heat-scroll" enable-flex>
      <view class="heat-grid">
        <view class="heat-week" wx:for="{{heatWeeks}}" wx:key="weekStart" wx:for-item="wk">
          <text class="heat-week-label" wx:if="{{index % 4 === 0}}">{{wk.label}}</text>
          <text class="heat-week-label heat-label-spacer" wx:else> </text>
          <view class="heat-days-col">
            <view wx:for="{{wk.days}}" wx:key="ts" wx:for-item="d"
                  class="heat-cell heat-l{{d.level}}"
                  hover-class="heat-cell-hover"></view>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="heat-legend">
      <text class="heat-legend-text">少</text>
      <view class="heat-cell heat-l0 legend-cell"></view>
      <view class="heat-cell heat-l1 legend-cell"></view>
      <view class="heat-cell heat-l2 legend-cell"></view>
      <view class="heat-cell heat-l3 legend-cell"></view>
      <view class="heat-cell heat-l4 legend-cell"></view>
      <text class="heat-legend-text">多</text>
    </view>
  </view>

  <!-- 部位分布 -->
  <view class="card" wx:if="{{hasData}}">
    <view class="card-title">部位训练分布</view>
    <view wx:for="{{muscleDist}}" wx:key="key" class="dist-row">
      <text class="dist-name">{{item.icon}} {{item.name}}</text>
      <view class="dist-track">
        <view class="dist-fill" style="width: {{item.pct}}%;"></view>
      </view>
      <text class="dist-val">{{item.volume}} kg</text>
    </view>
  </view>

  <!-- 个人纪录 -->
  <view class="card" wx:if="{{prs.length > 0}}">
    <view class="card-title">个人纪录 PR</view>
    <view wx:for="{{prs}}" wx:key="id" class="pr-row" hover-class="pr-row-hover"
          bindtap="onPrTrend" data-id="{{item.id}}">
      <view class="pr-left">
        <text class="pr-name">{{item.name}}</text>
        <text class="pr-date">{{item.dateText}}</text>
      </view>
      <view class="pr-right">
        <text class="pr-max">{{item.maxWeight}} <text class="pr-unit">kg</text></text>
        <text class="pr-best">最佳单组 {{item.bestSet}} kg<text wx:if="{{item.est1rm}}"> · 1RM≈{{item.est1rm}}</text></text>
      </view>
      <!-- 1RM 迷你趋势 + 大图入口 -->
      <view class="pr-trend-wrap" wx:if="{{item.trend.length > 0}}">
        <view class="pr-trend">
          <view class="pr-trend-bar" wx:for="{{item.trend}}" wx:for-item="t" wx:key="label" style="height: {{t.height}}%;" title="{{t.est}}kg"></view>
        </view>
        <view class="pr-chart-link" wx:if="{{item.trend.length > 1}}">趋势</view>
      </view>
    </view>
  </view>

  <!-- 1RM 大图（modal） -->
  <view class="chart-mask" wx:if="{{chartVisible}}" bindtap="onCloseChart">
    <view class="chart-panel" catchtap="noop">
      <view class="chart-panel-head">
        <view>
          <view class="chart-panel-title">{{chartName}}</view>
          <view class="chart-panel-sub">估算 1RM 历史趋势 · 最新 {{chartEst}} kg</view>
        </view>
        <view class="chart-close" bindtap="onCloseChart">✕</view>
      </view>
      <canvas type="2d" id="rmCanvas" class="chart-canvas-lg"></canvas>
    </view>
  </view>

  <!-- 体重趋势 -->
  <view class="card" wx:if="{{hasBodyData}}">
    <view class="bw-head">
      <view>
        <view class="card-title" style="margin-bottom: 4rpx;">体重趋势</view>
        <view class="bw-summary">当前 {{bwLatest}} kg · 累计 {{bwDeltaText}}</view>
      </view>
      <view class="bw-add" bindtap="onAddBodyweight">＋ 记录</view>
    </view>
    <view class="bars">
      <view wx:for="{{bwPoints}}" class="bar-col">
        <view class="bar-track">
          <view class="bar-fill bw-fill" style="height: {{item.height}}%;"></view>
        </view>
        <text class="bar-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 体重空态 -->
  <view class="card" wx:if="{{!hasBodyData && hasData}}">
    <view class="card-title">体重趋势</view>
    <view class="bw-empty">
      <text>记录体重，追踪增肌/减脂进度</text>
      <view class="btn-ghost bw-add-btn" bindtap="onAddBodyweight">＋ 记录体重</view>
    </view>
  </view>
</view>
