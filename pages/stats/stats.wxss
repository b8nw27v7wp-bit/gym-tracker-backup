.page {
  padding-bottom: 180rpx;
}

.hero-card {
  padding: 40rpx 32rpx;
}

/* 每日热量 */
.cal-card {
  padding: 28rpx 32rpx;
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cal-edit {
  font-size: 22rpx;
  color: #4f46e5;
  background: #eef2ff;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}

.cal-grid {
  display: flex;
  margin-top: 24rpx;
}

.cal-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cal-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1d1d1f;
  font-variant-numeric: tabular-nums;
}

.cal-accent {
  color: #4f46e5;
}

.cal-label {
  font-size: 21rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.cal-bar {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 16rpx 8rpx;
}

.cal-suggest {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cal-suggest-label {
  font-size: 20rpx;
  color: #9ca3af;
}

.cal-suggest-num {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.cal-divider {
  width: 1rpx;
  height: 40rpx;
  background: #e5e7eb;
}

.cal-tip {
  font-size: 20rpx;
  color: #c4c8cf;
  margin-top: 16rpx;
  text-align: center;
}

/* 摄入 vs 消耗 */
.cal-intake {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 14rpx 8rpx;
}

.cal-intake-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cal-intake-label {
  font-size: 19rpx;
  color: #9ca3af;
}

.cal-intake-num {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.gap-ok {
  color: #10b981;
}

.gap-over {
  color: #ef4444;
}

.cal-intake-btn {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #4f46e5;
  background: #eef2ff;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  margin-right: 8rpx;
}

.cal-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 8rpx;
}

.cal-empty-text {
  font-size: 24rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.7;
}

.cal-empty-btn {
  margin-top: 24rpx;
  width: 320rpx;
}

.big-num {
  font-size: 88rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.2;
  margin: 8rpx 0 4rpx;
}

.big-unit {
  font-size: 32rpx;
  font-weight: 500;
  color: #9ca3af;
}

.delta {
  font-size: 26rpx;
  margin-top: 8rpx;
}

.delta-up {
  color: #10b981;
}

.delta-down {
  color: #ef4444;
}

.delta-flat {
  color: #9ca3af;
}

/* 训练频率 */
.freq-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0 20rpx;
}

.freq-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.freq-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.freq-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.freq-divider {
  width: 1rpx;
  height: 56rpx;
  background: #f3f4f6;
}

.coverage-bar {
  border-top: 1rpx solid #f9fafb;
  padding-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.cov-chip {
  background: #f3f4f6;
  color: #374151;
  border-radius: 10rpx;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.cov-empty {
  font-size: 23rpx;
  color: #9ca3af;
}

/* 本周简报 */
.brief-row {
  display: flex;
  padding: 10rpx 0 4rpx;
}

.brief-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brief-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.brief-label {
  font-size: 21rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

/* 体重 */
.bw-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bw-summary {
  font-size: 23rpx;
  color: #9ca3af;
}

.bw-add {
  background: #1d1d1f;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 24rpx;
  padding: 10rpx 26rpx;
}

.bw-fill {
  background: #10b981;
}

.bw-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 8rpx;
  font-size: 25rpx;
  color: #9ca3af;
}

.bw-add-btn {
  margin-top: 20rpx;
  width: 60%;
}

/* 柱状图 */
.bars {
  display: flex;
  align-items: flex-end;
  height: 260rpx;
  padding-top: 20rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar-track {
  width: 40rpx;
  height: 200rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.bar-fill {
  width: 100%;
  background: #1d1d1f;
  border-radius: 12rpx;
}

.bar-empty {
  background: #e5e7eb;
  height: 8rpx !important;
  border-radius: 12rpx;
}

.bar-label {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 10rpx;
}

/* 训练热力图 */
.heat-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.heat-days {
  font-size: 22rpx;
  color: #9ca3af;
}

.heat-scroll {
  white-space: nowrap;
  width: 100%;
}

.heat-grid {
  display: flex;
  padding: 4rpx 0 8rpx;
}

.heat-week {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 8rpx;
}

.heat-week-label {
  font-size: 20rpx;
  color: #9ca3af;
  height: 32rpx;
  line-height: 32rpx;
  margin-bottom: 8rpx;
  font-variant-numeric: tabular-nums;
}

.heat-label-spacer {
  visibility: hidden;
}

.heat-days-col {
  display: flex;
  flex-direction: column;
}

.heat-cell {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  background: #f3f4f6;
  transition: opacity 0.15s;
}

.heat-l0 { background: #f3f4f6; }
.heat-l1 { background: #dbeafe; }
.heat-l2 { background: #93c5fd; }
.heat-l3 { background: #3b82f6; }
.heat-l4 { background: #1d4ed8; }

.heat-cell-hover {
  opacity: 0.7;
}

.heat-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.heat-legend-text {
  font-size: 20rpx;
  color: #9ca3af;
  margin: 0 8rpx;
}

.legend-cell {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  margin-bottom: 0;
  margin-right: 8rpx;
}

/* 部位热力图（GitHub 风格肌群矩阵） */
.gh-head,
.gh-row {
  display: flex;
  align-items: center;
}

.gh-head {
  margin-bottom: 10rpx;
}

.gh-head-name,
.gh-row-name {
  width: 90rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #9ca3af;
}

.gh-head-cells,
.gh-row-cells {
  display: flex;
  flex-shrink: 0;
}

.gh-head-label {
  width: 30rpx;
  margin-right: 7rpx;
  font-size: 18rpx;
  color: #c4c8cf;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.gh-head-label:last-child {
  margin-right: 0;
}

.gh-cell {
  width: 30rpx;
  height: 30rpx;
  border-radius: 7rpx;
  margin-right: 7rpx;
  background: #f3f4f6;
  flex-shrink: 0;
  transition: opacity 0.15s;
}

.gh-cell:last-child {
  margin-right: 0;
}

.gh-row {
  padding: 9rpx 10rpx;
  border-radius: 12rpx;
  margin: 0 -10rpx;
  position: relative;
}

.gh-row-hover {
  background: #f3f4f6;
}

.gh-row-active {
  background: #f7f7f8;
}

/* 选中行：左侧 indigo 竖条 + 名称/组数加深 */
.gh-row-active::before {
  content: '';
  position: absolute;
  left: -10rpx;
  top: 10rpx;
  bottom: 10rpx;
  width: 6rpx;
  border-radius: 3rpx;
  background: #4f46e5;
}

.gh-row-active .gh-row-name {
  color: #1d1d1f;
  font-weight: 600;
}

.gh-row-name {
  color: #374151;
}

.gh-row-total {
  width: 60rpx;
  text-align: right;
  font-size: 22rpx;
  color: #9ca3af;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  transition: color 0.15s;
}

.gh-row-active .gh-row-total {
  color: #1d1d1f;
  font-weight: 600;
}

.heat-tip {
  font-size: 20rpx;
  color: #c4c8cf;
  margin-top: 12rpx;
  text-align: center;
}

/* 常驻信息区：固定最小高度，选中/未选中切换不跳动 */
.heat-selected {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 14rpx;
  min-height: 76rpx;
  margin-top: 12rpx;
  padding: 14rpx 24rpx;
  box-sizing: border-box;
  background: #f7f7f8;
  border-radius: 12rpx;
}

.heat-selected-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.heat-selected-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
  flex-shrink: 0;
}

.heat-selected-val {
  font-size: 24rpx;
  color: #6b7280;
}

.heat-selected-hint {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 本卡片元素全部居中，图例与 tab/信息条对齐 */
.heat-legend-mid {
  justify-content: center;
}

.heat-empty {
  text-align: center;
  padding: 64rpx 0 40rpx;
}

.heat-empty-text {
  font-size: 26rpx;
  color: #9ca3af;
}

/* 部位分布 */
.dist-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.dist-name {
  width: 140rpx;
  font-size: 26rpx;
  color: #374151;
}

.dist-track {
  flex: 1;
  height: 20rpx;
  background: #f3f4f6;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.dist-fill {
  height: 100%;
  background: #1d1d1f;
  border-radius: 10rpx;
}

.dist-val {
  width: 140rpx;
  text-align: right;
  font-size: 24rpx;
  color: #6b7280;
}

/* PR */
.pr-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.pr-row:last-child {
  border-bottom: none;
}

.pr-left {
  display: flex;
  flex-direction: column;
}

.pr-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1d1d1f;
}

.pr-date {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.pr-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.pr-max {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.pr-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #9ca3af;
}

.pr-best {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

/* 训练智能：1RM 趋势预测 */
.pr-predict {
  font-size: 20rpx;
  color: #10b981;
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
}

/* 训练智能：减量周 / 冲 PR 提示 */
.deload-tip {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.deload-down {
  background: #fffbeb;
  color: #b45309;
}

.deload-up {
  background: #ecfdf5;
  color: #059669;
}

/* PR 1RM 迷你趋势 */
.pr-trend-wrap {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 4rpx;
}

.pr-trend {
  flex: 1;
  height: 56rpx;
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  padding-top: 8rpx;
}

.pr-trend-bar {
  flex: 1;
  min-height: 4rpx;
  background: #e0e7ff;
  border-radius: 4rpx 4rpx 0 0;
}

.pr-chart-link {
  font-size: 22rpx;
  color: #4f46e5;
  padding: 8rpx 20rpx;
  background: #eef2ff;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.pr-row-hover {
  background: #f7f7f8;
  border-radius: 12rpx;
}

/* 图表 canvas */
.chart-canvas {
  width: 100%;
  height: 340rpx;
  display: block;
  margin-top: 16rpx;
}

/* 1RM 大图 modal */
.chart-mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.45);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.chart-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(17, 24, 39, 0.06), 0 16rpx 48rpx rgba(17, 24, 39, 0.12);
}

.chart-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.chart-panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.chart-panel-sub {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.chart-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.chart-canvas-lg {
  width: 100%;
  height: 440rpx;
  display: block;
}

/* 个人中心卡片 */
.profile-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
}

.profile-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.profile-avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}

.profile-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f3f4f6;
  border: 2rpx solid #e5e7eb;
}

.profile-avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #818cf8, #4f46e5);
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.profile-desc {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.profile-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.profile-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.profile-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-stat-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.profile-stat-label {
  font-size: 20rpx;
  color: #9ca3af;
}

.profile-stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: #e5e7eb;
}

.profile-arrow {
  font-size: 36rpx;
  color: #d1d5db;
}

/* 月度总结 */
.monthly-grid {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.monthly-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.monthly-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.monthly-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* 肌群平衡分析 */
.balance-chart {
  margin: 20rpx 0;
}

.balance-bar {
  height: 24rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
}

.balance-fill {
  height: 100%;
  transition: width 0.3s ease;
}

.balance-fill.push {
  background: #3b82f6;
}

.balance-fill.pull {
  background: #22c55e;
}

.balance-fill.legs {
  background: #f59e0b;
}

.balance-labels {
  display: flex;
  justify-content: space-around;
  margin-top: 16rpx;
}

.balance-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.balance-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.balance-dot.push {
  background: #3b82f6;
}

.balance-dot.pull {
  background: #22c55e;
}

.balance-dot.legs {
  background: #f59e0b;
}

.balance-advice {
  font-size: 24rpx;
  color: #6b7280;
  background: #f9fafb;
  padding: 16rpx;
  border-radius: 12rpx;
  margin: 16rpx 0;
}

.balance-detail {
  display: flex;
  justify-content: space-between;
}

.balance-detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.balance-detail-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.balance-detail-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-top: 4rpx;
}

/* 训练密度趋势 */
.density-hint {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 16rpx;
}

.density-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
}

.density-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.density-track {
  width: 40rpx;
  height: 160rpx;
  background: #f3f4f6;
  border-radius: 8rpx;
  display: flex;
  align-items: flex-end;
}

.density-fill {
  width: 100%;
  background: #818cf8;
  border-radius: 8rpx;
  transition: height 0.3s ease;
}

.density-label {
  font-size: 18rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

.density-value {
  font-size: 20rpx;
  font-weight: 600;
  color: #1d1d1f;
}

/* 周训练频率 */
.freq-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  margin-top: 16rpx;
}

.freq-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.freq-track {
  width: 40rpx;
  height: 160rpx;
  background: #f3f4f6;
  border-radius: 8rpx;
  display: flex;
  align-items: flex-end;
}

.freq-fill {
  width: 100%;
  background: #22c55e;
  border-radius: 8rpx;
  min-height: 4rpx;
  transition: height 0.3s ease;
}

.freq-label {
  font-size: 18rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

.freq-value {
  font-size: 20rpx;
  font-weight: 600;
  color: #1d1d1f;
}

/* ========== v5�������� + �ɾ� ========== */
.streak-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.streak-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.streak-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.streak-label {
  font-size: 21rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.streak-divider {
  width: 1rpx;
  height: 56rpx;
  background: #f3f4f6;
}

.ach-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.ach-item {
  width: calc(50% - 8rpx);
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 16rpx;
}

.ach-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #e5e7eb;
  flex-shrink: 0;
}

.ach-dot-on {
  background: #4f46e5;
  box-shadow: 0 0 0 6rpx rgba(79, 70, 229, 0.12);
}

.ach-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.ach-name {
  font-size: 25rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.ach-desc {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ========== v5��ѵ��Ŀ�� ========== */
.goal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.goal-edit {
  font-size: 24rpx;
  color: #4f46e5;
}

.goal-progress-block {
  margin-bottom: 20rpx;
}

.goal-progress-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.goal-progress-name {
  font-size: 25rpx;
  font-weight: 500;
  color: #1d1d1f;
}

.goal-progress-val {
  font-size: 22rpx;
  color: #6b7280;
}

.goal-track {
  position: relative;
  height: 14rpx;
  background: #f3f4f6;
  border-radius: 999rpx;
  overflow: hidden;
}

.goal-fill {
  height: 100%;
  background: linear-gradient(90deg, #818cf8, #4f46e5);
  border-radius: 999rpx;
  transition: width 0.3s;
}

.goal-fill-done {
  background: linear-gradient(90deg, #34d399, #10b981);
}

.goal-progress-pct {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 4rpx;
  display: inline-block;
}

.goal-advice {
  margin-top: 8rpx;
}

.goal-advice-line {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.6;
}

/* ========== v5������ָ� ========== */
.rec-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0;
}

.rec-name {
  width: 96rpx;
  font-size: 23rpx;
  color: #1d1d1f;
  flex-shrink: 0;
}

.rec-track {
  flex: 1;
  height: 12rpx;
  background: #f3f4f6;
  border-radius: 999rpx;
  overflow: hidden;
}

.rec-fill {
  height: 100%;
  border-radius: 999rpx;
}

.rec-low {
  background: #93c5fd;
}

.rec-ok {
  background: #10b981;
}

.rec-high {
  background: #f59e0b;
}

.rec-val {
  width: 88rpx;
  text-align: right;
  font-size: 23rpx;
  color: #1d1d1f;
  flex-shrink: 0;
}

.rec-range {
  color: #9ca3af;
}

.rec-tips {
  margin-top: 16rpx;
}

.rec-tip {
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.6;
}

.rec-legend {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.rec-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 21rpx;
  color: #9ca3af;
}

.rec-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}

/* ========== v5������Χ��ժҪ ========== */
.ms-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.ms-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 16rpx;
}

.ms-cell-name {
  font-size: 22rpx;
  color: #9ca3af;
}

.ms-cell-val {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-top: 4rpx;
}

.ms-cell-delta {
  font-size: 20rpx;
  margin-top: 2rpx;
}

.ms-cell-up {
  color: #10b981;
}

.ms-cell-down {
  color: #ef4444;
}

.ms-more {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #4f46e5;
  text-align: center;
}
