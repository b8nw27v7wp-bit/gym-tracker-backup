.page {
  padding-bottom: 140rpx;
}

.hero-card {
  padding: 40rpx 32rpx;
}

.big-num {
  font-size: 88rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.2;
  margin: 8rpx 0 4rpx;
}

.big-unit {
  font-size: 32rpx;
  font-weight: 500;
  color: #9ca3af;
}

.delta {
  font-size: 26rpx;
  margin-top: 8rpx;
}

.delta-up {
  color: #10b981;
}

.delta-down {
  color: #ef4444;
}

.delta-flat {
  color: #9ca3af;
}

/* 训练频率 */
.freq-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0 20rpx;
}

.freq-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.freq-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.freq-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.freq-divider {
  width: 1rpx;
  height: 56rpx;
  background: #f3f4f6;
}

.coverage-bar {
  border-top: 1rpx solid #f9fafb;
  padding-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.cov-chip {
  background: #f3f4f6;
  color: #374151;
  border-radius: 10rpx;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.cov-empty {
  font-size: 23rpx;
  color: #9ca3af;
}

/* 本周简报 */
.brief-row {
  display: flex;
  padding: 10rpx 0 4rpx;
}

.brief-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brief-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.brief-label {
  font-size: 21rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

/* 体重 */
.bw-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bw-summary {
  font-size: 23rpx;
  color: #9ca3af;
}

.bw-add {
  background: #1d1d1f;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 24rpx;
  padding: 10rpx 26rpx;
}

.bw-fill {
  background: #10b981;
}

.bw-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 8rpx;
  font-size: 25rpx;
  color: #9ca3af;
}

.bw-add-btn {
  margin-top: 20rpx;
  width: 60%;
}

/* 柱状图 */
.bars {
  display: flex;
  align-items: flex-end;
  height: 260rpx;
  padding-top: 20rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar-track {
  width: 40rpx;
  height: 200rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.bar-fill {
  width: 100%;
  background: #1d1d1f;
  border-radius: 12rpx;
}

.bar-empty {
  background: #e5e7eb;
  height: 8rpx !important;
  border-radius: 12rpx;
}

.bar-label {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 10rpx;
}

/* 训练热力图 */
.heat-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.heat-days {
  font-size: 22rpx;
  color: #9ca3af;
}

.heat-scroll {
  white-space: nowrap;
  width: 100%;
}

.heat-grid {
  display: flex;
  padding: 4rpx 0 8rpx;
}

.heat-week {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 8rpx;
}

.heat-week-label {
  font-size: 18rpx;
  color: #9ca3af;
  height: 28rpx;
  line-height: 28rpx;
  margin-bottom: 6rpx;
}

.heat-label-spacer {
  visibility: hidden;
}

.heat-days-col {
  display: flex;
  flex-direction: column;
}

.heat-cell {
  width: 26rpx;
  height: 26rpx;
  border-radius: 6rpx;
  margin-bottom: 6rpx;
  background: #f3f4f6;
}

.heat-l0 { background: #f3f4f6; }
.heat-l1 { background: #dbeafe; }
.heat-l2 { background: #93c5fd; }
.heat-l3 { background: #3b82f6; }
.heat-l4 { background: #1d4ed8; }

.heat-cell-hover {
  opacity: 0.7;
}

.heat-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.heat-legend-text {
  font-size: 20rpx;
  color: #9ca3af;
  margin: 0 8rpx;
}

.legend-cell {
  width: 20rpx;
  height: 20rpx;
  margin-bottom: 0;
  margin-right: 6rpx;
}

/* 部位分布 */
.dist-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.dist-name {
  width: 140rpx;
  font-size: 26rpx;
  color: #374151;
}

.dist-track {
  flex: 1;
  height: 20rpx;
  background: #f3f4f6;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.dist-fill {
  height: 100%;
  background: #1d1d1f;
  border-radius: 10rpx;
}

.dist-val {
  width: 140rpx;
  text-align: right;
  font-size: 24rpx;
  color: #6b7280;
}

/* PR */
.pr-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.pr-row:last-child {
  border-bottom: none;
}

.pr-left {
  display: flex;
  flex-direction: column;
}

.pr-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1d1d1f;
}

.pr-date {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.pr-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.pr-max {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.pr-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #9ca3af;
}

.pr-best {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

/* PR 1RM 迷你趋势 */
.pr-trend {
  width: 100%;
  height: 56rpx;
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  padding-top: 8rpx;
  margin-top: 4rpx;
}

.pr-trend-bar {
  flex: 1;
  min-height: 4rpx;
  background: #e0e7ff;
  border-radius: 4rpx 4rpx 0 0;
}
