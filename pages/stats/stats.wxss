.page {
  padding-bottom: 180rpx;
}

.hero-card {
  padding: 40rpx 32rpx;
}

/* 每日热量 */
.cal-card {
  padding: 28rpx 32rpx;
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cal-edit {
  font-size: 22rpx;
  color: #4f46e5;
  background: #eef2ff;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}

.cal-grid {
  display: flex;
  margin-top: 24rpx;
}

.cal-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cal-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1d1d1f;
  font-variant-numeric: tabular-nums;
}

.cal-accent {
  color: #4f46e5;
}

.cal-label {
  font-size: 21rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.cal-bar {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 16rpx 8rpx;
}

.cal-suggest {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cal-suggest-label {
  font-size: 20rpx;
  color: #9ca3af;
}

.cal-suggest-num {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.cal-divider {
  width: 1rpx;
  height: 40rpx;
  background: #e5e7eb;
}

.cal-tip {
  font-size: 20rpx;
  color: #c4c8cf;
  margin-top: 16rpx;
  text-align: center;
}

/* 摄入 vs 消耗 */
.cal-intake {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 14rpx 8rpx;
}

.cal-intake-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cal-intake-label {
  font-size: 19rpx;
  color: #9ca3af;
}

.cal-intake-num {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.gap-ok {
  color: #10b981;
}

.gap-over {
  color: #ef4444;
}

.cal-intake-btn {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #4f46e5;
  background: #eef2ff;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  margin-right: 8rpx;
}

.cal-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 8rpx;
}

.cal-empty-text {
  font-size: 24rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.7;
}

.cal-empty-btn {
  margin-top: 24rpx;
  width: 320rpx;
}

.big-num {
  font-size: 88rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.2;
  margin: 8rpx 0 4rpx;
}

.big-unit {
  font-size: 32rpx;
  font-weight: 500;
  color: #9ca3af;
}

.delta {
  font-size: 26rpx;
  margin-top: 8rpx;
}

.delta-up {
  color: #10b981;
}

.delta-down {
  color: #ef4444;
}

.delta-flat {
  color: #9ca3af;
}

/* 训练频率 */
.freq-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0 20rpx;
}

.freq-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.freq-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.freq-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.freq-divider {
  width: 1rpx;
  height: 56rpx;
  background: #f3f4f6;
}

.coverage-bar {
  border-top: 1rpx solid #f9fafb;
  padding-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.cov-chip {
  background: #f3f4f6;
  color: #374151;
  border-radius: 10rpx;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.cov-empty {
  font-size: 23rpx;
  color: #9ca3af;
}

/* 本周简报 */
.brief-row {
  display: flex;
  padding: 10rpx 0 4rpx;
}

.brief-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brief-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.brief-label {
  font-size: 21rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

/* 体重 */
.bw-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bw-summary {
  font-size: 23rpx;
  color: #9ca3af;
}

.bw-add {
  background: #1d1d1f;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 24rpx;
  padding: 10rpx 26rpx;
}

.bw-fill {
  background: #10b981;
}

.bw-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 8rpx;
  font-size: 25rpx;
  color: #9ca3af;
}

.bw-add-btn {
  margin-top: 20rpx;
  width: 60%;
}

/* 柱状图 */
.bars {
  display: flex;
  align-items: flex-end;
  height: 260rpx;
  padding-top: 20rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar-track {
  width: 40rpx;
  height: 200rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.bar-fill {
  width: 100%;
  background: #1d1d1f;
  border-radius: 12rpx;
}

.bar-empty {
  background: #e5e7eb;
  height: 8rpx !important;
  border-radius: 12rpx;
}

.bar-label {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 10rpx;
}

/* 训练热力图 */
.heat-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.heat-days {
  font-size: 22rpx;
  color: #9ca3af;
}

.heat-scroll {
  white-space: nowrap;
  width: 100%;
}

.heat-grid {
  display: flex;
  padding: 4rpx 0 8rpx;
}

.heat-week {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 8rpx;
}

.heat-week-label {
  font-size: 18rpx;
  color: #9ca3af;
  height: 28rpx;
  line-height: 28rpx;
  margin-bottom: 6rpx;
}

.heat-label-spacer {
  visibility: hidden;
}

.heat-days-col {
  display: flex;
  flex-direction: column;
}

.heat-cell {
  width: 26rpx;
  height: 26rpx;
  border-radius: 6rpx;
  margin-bottom: 6rpx;
  background: #f3f4f6;
}

.heat-l0 { background: #f3f4f6; }
.heat-l1 { background: #dbeafe; }
.heat-l2 { background: #93c5fd; }
.heat-l3 { background: #3b82f6; }
.heat-l4 { background: #1d4ed8; }

.heat-cell-hover {
  opacity: 0.7;
}

.heat-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.heat-legend-text {
  font-size: 20rpx;
  color: #9ca3af;
  margin: 0 8rpx;
}

.legend-cell {
  width: 20rpx;
  height: 20rpx;
  margin-bottom: 0;
  margin-right: 6rpx;
}

/* 部位分布 */
.dist-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.dist-name {
  width: 140rpx;
  font-size: 26rpx;
  color: #374151;
}

.dist-track {
  flex: 1;
  height: 20rpx;
  background: #f3f4f6;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.dist-fill {
  height: 100%;
  background: #1d1d1f;
  border-radius: 10rpx;
}

.dist-val {
  width: 140rpx;
  text-align: right;
  font-size: 24rpx;
  color: #6b7280;
}

/* PR */
.pr-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.pr-row:last-child {
  border-bottom: none;
}

.pr-left {
  display: flex;
  flex-direction: column;
}

.pr-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1d1d1f;
}

.pr-date {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.pr-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.pr-max {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.pr-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #9ca3af;
}

.pr-best {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

/* PR 1RM 迷你趋势 */
.pr-trend-wrap {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 4rpx;
}

.pr-trend {
  flex: 1;
  height: 56rpx;
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  padding-top: 8rpx;
}

.pr-trend-bar {
  flex: 1;
  min-height: 4rpx;
  background: #e0e7ff;
  border-radius: 4rpx 4rpx 0 0;
}

.pr-chart-link {
  font-size: 22rpx;
  color: #4f46e5;
  padding: 8rpx 20rpx;
  background: #eef2ff;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.pr-row-hover {
  background: #f7f7f8;
  border-radius: 12rpx;
}

/* 图表 canvas */
.chart-canvas {
  width: 100%;
  height: 340rpx;
  display: block;
  margin-top: 16rpx;
}

/* 1RM 大图 modal */
.chart-mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.45);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.chart-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(17, 24, 39, 0.06), 0 16rpx 48rpx rgba(17, 24, 39, 0.12);
}

.chart-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.chart-panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.chart-panel-sub {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.chart-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.chart-canvas-lg {
  width: 100%;
  height: 440rpx;
  display: block;
}

/* 个人中心卡片 */
.profile-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
}

.profile-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.profile-avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}

.profile-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f3f4f6;
  border: 2rpx solid #e5e7eb;
}

.profile-avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #818cf8, #4f46e5);
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.profile-desc {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.profile-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.profile-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.profile-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-stat-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.profile-stat-label {
  font-size: 20rpx;
  color: #9ca3af;
}

.profile-stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: #e5e7eb;
}

.profile-arrow {
  font-size: 36rpx;
  color: #d1d5db;
}

/* 月度总结 */
.monthly-grid {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.monthly-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.monthly-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.monthly-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* 肌群平衡分析 */
.balance-chart {
  margin: 20rpx 0;
}

.balance-bar {
  height: 24rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
}

.balance-fill {
  height: 100%;
  transition: width 0.3s ease;
}

.balance-fill.push {
  background: #3b82f6;
}

.balance-fill.pull {
  background: #22c55e;
}

.balance-fill.legs {
  background: #f59e0b;
}

.balance-labels {
  display: flex;
  justify-content: space-around;
  margin-top: 16rpx;
}

.balance-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.balance-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.balance-dot.push {
  background: #3b82f6;
}

.balance-dot.pull {
  background: #22c55e;
}

.balance-dot.legs {
  background: #f59e0b;
}

.balance-advice {
  font-size: 24rpx;
  color: #6b7280;
  background: #f9fafb;
  padding: 16rpx;
  border-radius: 12rpx;
  margin: 16rpx 0;
}

.balance-detail {
  display: flex;
  justify-content: space-between;
}

.balance-detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.balance-detail-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.balance-detail-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-top: 4rpx;
}

/* 训练密度趋势 */
.density-hint {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 16rpx;
}

.density-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
}

.density-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.density-track {
  width: 40rpx;
  height: 160rpx;
  background: #f3f4f6;
  border-radius: 8rpx;
  display: flex;
  align-items: flex-end;
}

.density-fill {
  width: 100%;
  background: #818cf8;
  border-radius: 8rpx;
  transition: height 0.3s ease;
}

.density-label {
  font-size: 18rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

.density-value {
  font-size: 20rpx;
  font-weight: 600;
  color: #1d1d1f;
}

/* 周训练频率 */
.freq-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  margin-top: 16rpx;
}

.freq-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.freq-track {
  width: 40rpx;
  height: 160rpx;
  background: #f3f4f6;
  border-radius: 8rpx;
  display: flex;
  align-items: flex-end;
}

.freq-fill {
  width: 100%;
  background: #22c55e;
  border-radius: 8rpx;
  min-height: 4rpx;
  transition: height 0.3s ease;
}

.freq-label {
  font-size: 18rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

.freq-value {
  font-size: 20rpx;
  font-weight: 600;
  color: #1d1d1f;
}
