.page {
  padding-bottom: 60rpx;
}

.hero-card {
  padding: 40rpx 32rpx;
}

.big-num {
  font-size: 88rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.2;
  margin: 8rpx 0 4rpx;
}

.big-unit {
  font-size: 32rpx;
  font-weight: 500;
  color: #9ca3af;
}

.delta {
  font-size: 26rpx;
  margin-top: 8rpx;
}

.delta-up {
  color: #10b981;
}

.delta-down {
  color: #ef4444;
}

.delta-flat {
  color: #9ca3af;
}

/* 训练频率 */
.freq-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0 20rpx;
}

.freq-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.freq-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #111827;
}

.freq-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.freq-divider {
  width: 1rpx;
  height: 56rpx;
  background: #f3f4f6;
}

.coverage-bar {
  border-top: 1rpx solid #f9fafb;
  padding-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.cov-chip {
  background: #f3f4f6;
  color: #374151;
  border-radius: 10rpx;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.cov-empty {
  font-size: 23rpx;
  color: #9ca3af;
}

/* 柱状图 */
.bars {
  display: flex;
  align-items: flex-end;
  height: 260rpx;
  padding-top: 20rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar-track {
  width: 40rpx;
  height: 200rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.bar-fill {
  width: 100%;
  background: #111827;
  border-radius: 12rpx;
}

.bar-empty {
  background: #e5e7eb;
  height: 8rpx !important;
  border-radius: 12rpx;
}

.bar-label {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 10rpx;
}

/* 部位分布 */
.dist-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.dist-name {
  width: 140rpx;
  font-size: 26rpx;
  color: #374151;
}

.dist-track {
  flex: 1;
  height: 20rpx;
  background: #f3f4f6;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.dist-fill {
  height: 100%;
  background: #111827;
  border-radius: 10rpx;
}

.dist-val {
  width: 140rpx;
  text-align: right;
  font-size: 24rpx;
  color: #6b7280;
}

/* PR */
.pr-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.pr-row:last-child {
  border-bottom: none;
}

.pr-left {
  display: flex;
  flex-direction: column;
}

.pr-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
}

.pr-date {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.pr-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.pr-max {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.pr-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #9ca3af;
}

.pr-best {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}
