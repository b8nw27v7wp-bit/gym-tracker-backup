.page {
  padding-bottom: 140rpx;
}

.search-wrap {
  padding: 24rpx 32rpx 8rpx;
}

.search-input {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  font-size: 27rpx;
  box-shadow: 0 2rpx 12rpx rgba(17, 24, 39, 0.04);
}

/* 部位 chips 横滑 */
.muscle-scroll {
  white-space: nowrap;
  padding: 20rpx 32rpx 4rpx;
  box-sizing: border-box;
}

.chip {
  display: inline-block;
  background: #ffffff;
  color: #374151;
  border-radius: 16rpx;
  font-size: 25rpx;
  padding: 14rpx 26rpx;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(17, 24, 39, 0.04);
}

.chip-active {
  background: #1d1d1f;
  color: #ffffff;
}

/* 类型/难度筛选 */
.filter-row {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx 8rpx;
}

.mini-chip {
  background: #ffffff;
  color: #9ca3af;
  border-radius: 12rpx;
  font-size: 23rpx;
  padding: 8rpx 20rpx;
  margin-right: 12rpx;
}

.mini-active {
  background: #f3f4f6;
  color: #1d1d1f;
  font-weight: 500;
}

.filter-gap {
  width: 24rpx;
}

/* 动作卡片 */
.ex-card {
  padding: 28rpx 32rpx;
  margin: 16rpx 32rpx;
}

.ex-head {
  display: flex;
  align-items: center;
}

.ex-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-right: 16rpx;
}

.ex-tag {
  font-size: 21rpx;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-right: 10rpx;
}

.ex-type {
  background: #eef2ff;
  color: #4f46e5;
}

.ex-diff {
  background: #f0fdf4;
  color: #16a34a;
}

.ex-targets {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
}

.ex-target {
  background: #f9fafb;
  border-radius: 10rpx;
  font-size: 23rpx;
  color: #6b7280;
  padding: 6rpx 16rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.ex-meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #9ca3af;
}

.meta-dot {
  margin: 0 8rpx;
}
