.page {
  padding-bottom: 140rpx;
}

.search-wrap {
  padding: 24rpx 32rpx 8rpx;
}

.search-input {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  font-size: 27rpx;
  box-shadow: 0 2rpx 12rpx rgba(17, 24, 39, 0.04);
}

/* 部位 chips 横滑 */
.muscle-scroll {
  white-space: nowrap;
  padding: 20rpx 32rpx 4rpx;
  box-sizing: border-box;
}

.chip {
  display: inline-block;
  background: #ffffff;
  color: #374151;
  border-radius: 16rpx;
  font-size: 25rpx;
  padding: 14rpx 26rpx;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(17, 24, 39, 0.04);
}

.chip-active {
  background: #1d1d1f;
  color: #ffffff;
}

/* 类型/难度筛选 */
.filter-row {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx 8rpx;
}

.mini-chip {
  background: #ffffff;
  color: #9ca3af;
  border-radius: 12rpx;
  font-size: 23rpx;
  padding: 8rpx 20rpx;
  margin-right: 12rpx;
}

.mini-active {
  background: #f3f4f6;
  color: #1d1d1f;
  font-weight: 500;
}

.filter-gap {
  width: 24rpx;
}

/* 部位训练指南入口 */
.guide-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 32rpx 4rpx;
  background: linear-gradient(90deg, #f5f6ff 0%, #ffffff 100%);
  border: 1rpx solid #e0e7ff;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
}

.guide-entry-hover {
  background: #eef2ff;
}

.guide-entry-left {
  display: flex;
  flex-direction: column;
}

.guide-entry-title {
  font-size: 27rpx;
  font-weight: 500;
  color: #1d1d1f;
}

.guide-entry-sub {
  font-size: 21rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.guide-entry-arrow {
  color: #4f46e5;
  font-size: 32rpx;
}
