<view class="page">
  <!-- 搜索 -->
  <view class="search-wrap">
    <input
      class="search-input"
      value="{{keyword}}"
      bindinput="onSearchInput"
      placeholder="🔍 搜索动作名称或肌群"
      confirm-type="search"
    />
  </view>

  <!-- 部位筛选 -->
  <scroll-view class="muscle-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      class="chip {{currentMuscle === 'all' ? 'chip-active' : ''}}"
      data-key="all"
      bindtap="onPickMuscle"
    >全部 {{allCount}}</view>
    <view
      wx:for="{{muscles}}"
      wx:key="key"
      class="chip {{currentMuscle === item.key ? 'chip-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onPickMuscle"
    >{{item.icon}} {{item.name}} {{item.count}}</view>
  </scroll-view>

  <!-- 类型/难度筛选 -->
  <view class="filter-row">
    <view
      wx:for="{{typeFilters}}"
      wx:key="key"
      class="mini-chip {{typeFilter === item.key ? 'mini-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onPickType"
    >{{item.name}}</view>
    <view class="filter-gap"></view>
    <view
      wx:for="{{diffFilters}}"
      wx:key="key"
      class="mini-chip {{diffFilter === item.key ? 'mini-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onPickDiff"
    >{{item.name}}</view>
  </view>

  <!-- 动作列表 -->
  <view wx:if="{{list.length === 0}}" class="empty">
    <view class="empty-icon">🔍</view>
    <view>没有找到匹配的动作</view>
  </view>

  <view
    wx:for="{{list}}"
    wx:key="id"
    class="card ex-card"
    data-id="{{item.id}}"
    bindtap="onOpenDetail"
  >
    <view class="ex-head">
      <text class="ex-name">{{item.name}}</text>
      <text class="ex-tag ex-type">{{item.typeText}}</text>
      <text class="ex-tag ex-diff">{{item.diffText}}</text>
    </view>
    <view class="ex-targets">
      <text wx:for="{{item.target}}" wx:for-item="t" wx:key="*this" class="ex-target">{{t}}</text>
    </view>
    <view class="ex-meta">
      <text>{{item.equipText}}</text>
      <text class="meta-dot">·</text>
      <text>{{item.rest}}</text>
      <text class="meta-dot">·</text>
      <text>{{item.muscleName}}</text>
    </view>
  </view>
</view>
