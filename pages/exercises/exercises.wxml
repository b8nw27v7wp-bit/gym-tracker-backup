<view class="page">
  <!-- 从训练页跳来时的返回条 -->
  <view class="back-bar" wx:if="{{showBack}}" hover-class="back-bar-hover" bindtap="onBackToTrain">
    <view class="back-bar-arrow"></view>
    <text>返回训练</text>
    <text class="back-bar-sub">当前筛选：{{currentMuscleName}}</text>
  </view>

  <!-- 搜索 -->
  <view class="search-wrap">
    <input
      class="search-input"
      value="{{keyword}}"
      bindinput="onSearchInput"
      placeholder="搜索动作名称或肌群"
      confirm-type="search"
    />
  </view>

  <!-- 部位筛选 -->
  <scroll-view class="muscle-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      class="chip {{currentMuscle === 'all' ? 'chip-active' : ''}}"
      data-key="all"
      bindtap="onPickMuscle"
    >全部 {{allCount}}</view>
    <view
      wx:for="{{muscles}}"
      wx:key="key"
      class="chip {{currentMuscle === item.key ? 'chip-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onPickMuscle"
    >{{item.icon}} {{item.name}} {{item.count}}</view>
  </scroll-view>

  <!-- 部位训练指南入口 -->
  <view class="guide-entry" hover-class="guide-entry-hover" bindtap="onOpenMuscleGuide">
    <view class="guide-entry-left">
      <view class="guide-entry-title">部位训练指南</view>
      <view class="guide-entry-sub">按肌肉发力分区查看训练动作</view>
    </view>
    <text class="guide-entry-arrow">›</text>
  </view>

  <!-- 类型/难度筛选 -->
  <view class="filter-row">
    <view
      wx:for="{{typeFilters}}"
      wx:key="key"
      class="mini-chip {{typeFilter === item.key ? 'mini-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onPickType"
    >{{item.name}}</view>
    <view class="filter-gap"></view>
    <view
      wx:for="{{diffFilters}}"
      wx:key="key"
      class="mini-chip {{diffFilter === item.key ? 'mini-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onPickDiff"
    >{{item.name}}</view>
  </view>

  <!-- 动作列表 -->
  <empty-state wx:if="{{list.length === 0}}" text="没有找到匹配的动作" />

  <ex-card
    wx:for="{{list}}"
    wx:key="id"
    name="{{item.name}}"
    type-text="{{item.typeText}}"
    diff-text="{{item.diffText}}"
    target="{{item.target}}"
    equip-text="{{item.equipText}}"
    rest="{{item.rest}}"
    muscle-name="{{item.muscleName}}"
    data-id="{{item.id}}"
    bind:tap="onOpenDetail"
  />
</view>
