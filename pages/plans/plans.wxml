<view class="page">
  <!-- 自建计划入口 -->
  <view class="new-plan-btn" bindtap="onNewPlan">＋ 自建计划</view>

  <!-- 计划列表 -->
  <view
    wx:for="{{summaries}}"
    wx:key="id"
    class="card plan-card {{currentPlanId === item.id ? 'plan-active' : ''}}"
    data-id="{{item.id}}"
    bindtap="onPickPlan"
  >
    <view class="plan-head">
      <text class="plan-name">{{item.name}}</text>
      <text wx:if="{{item.custom}}" class="plan-level plan-level-custom">自建</text>
      <text wx:else class="plan-level">{{item.level}}</text>
    </view>
    <view class="plan-desc">{{item.desc}}</view>
    <view class="plan-meta">{{item.daysPerWeek}} 练/周 · {{item.dayCount}} 天 · {{item.exerciseCount}} 个动作位</view>
  </view>

  <!-- 选中计划的天列表 -->
  <view wx:if="{{currentPlan}}">
    <view class="section-title">
      {{currentPlan.name}} · 选择训练日
      <view wx:if="{{currentPlan.custom}}" class="plan-ops">
        <text class="plan-op" data-id="{{currentPlan.planId}}" catchtap="onEditPlan">编辑</text>
        <text class="plan-op plan-op-del" data-id="{{currentPlan.planId}}" catchtap="onDeletePlan">删除</text>
      </view>
    </view>
    <view wx:for="{{currentPlan.days}}" wx:key="id" class="card day-card">
      <view class="day-head">
        <view>
          <text class="day-name">{{item.name}}</text>
          <text wx:if="{{item.note}}" class="day-note">{{item.note}}</text>
        </view>
        <view class="day-badge day-badge-done" wx:if="{{item.done}}">✅ 今日已完成</view>
        <view class="day-badge" wx:elif="{{item.compDone > 0}}">今日完成 {{item.compDone}}/{{item.compTotal}}</view>
      </view>
      <!-- 今日进度条（部分完成时显示） -->
      <view class="day-progress" wx:if="{{item.compDone > 0 && !item.done}}">
        <view class="day-progress-fill" style="width: {{item.compPct}}%;"></view>
      </view>
      <view class="day-items">
        <view wx:for="{{item.items}}" wx:for-item="ex" wx:key="exerciseId" class="day-item">
          <text class="day-item-name">{{ex.exerciseName}}</text>
          <text class="day-item-sets">{{ex.sets}} × {{ex.repsText}}</text>
        </view>
      </view>
      <view class="day-start" data-plan="{{currentPlanId}}" data-day="{{item.id}}" bindtap="onStartDay">开始这天的训练 →</view>
    </view>
  </view>
</view>
