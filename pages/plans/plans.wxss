.page {
  padding-bottom: 60rpx;
}

.plan-card {
  padding: 28rpx 32rpx;
  margin: 16rpx 32rpx;
}

.plan-active {
  border: 2rpx solid #111827;
}

.plan-head {
  display: flex;
  align-items: center;
}

.plan-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.plan-level {
  margin-left: 16rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 22rpx;
  border-radius: 10rpx;
  padding: 4rpx 16rpx;
}

.plan-desc {
  font-size: 25rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-top: 10rpx;
}

.plan-meta {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 10rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  padding: 24rpx 40rpx 8rpx;
}

.day-card {
  padding: 28rpx 32rpx;
  margin: 16rpx 32rpx;
}

.day-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.day-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.day-note {
  font-size: 22rpx;
  color: #9ca3af;
  margin-left: 14rpx;
}

.day-items {
  margin-top: 16rpx;
  border-top: 1rpx solid #f9fafb;
  padding-top: 8rpx;
}

.day-item {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}

.day-item-name {
  font-size: 26rpx;
  color: #374151;
}

.day-item-sets {
  font-size: 24rpx;
  color: #6b7280;
}

.day-start {
  margin-top: 16rpx;
  background: #111827;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 500;
  border-radius: 14rpx;
  padding: 18rpx 0;
  text-align: center;
}

.day-start:active {
  opacity: 0.85;
}
