.page {
  padding-bottom: 60rpx;
}

.new-plan-btn {
  margin: 20rpx 32rpx 0;
  background: #ffffff;
  border: 2rpx dashed #d1d5db;
  color: #374151;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 16rpx;
  padding: 22rpx 0;
  text-align: center;
}

.new-plan-btn:active {
  background: #f9fafb;
}

.plan-card {
  padding: 28rpx 32rpx;
  margin: 16rpx 32rpx;
}

.plan-active {
  border: 2rpx solid #1d1d1f;
}

.plan-head {
  display: flex;
  align-items: center;
}

.plan-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.plan-level {
  margin-left: 16rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 22rpx;
  border-radius: 10rpx;
  padding: 4rpx 16rpx;
}

.plan-level-custom {
  background: #ecfdf5;
  color: #059669;
}

/* 自定义计划操作 */
.plan-ops {
  display: inline-flex;
  margin-left: 16rpx;
}

.plan-op {
  font-size: 24rpx;
  color: #4f46e5;
  font-weight: 500;
  padding: 4rpx 20rpx;
  background: #eef2ff;
  border-radius: 10rpx;
  margin-left: 12rpx;
}

.plan-op-del {
  color: #ef4444;
  background: #fef2f2;
}

.plan-desc {
  font-size: 25rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-top: 10rpx;
}

.plan-meta {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 10rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  padding: 24rpx 40rpx 8rpx;
}

.day-card {
  padding: 28rpx 32rpx;
  margin: 16rpx 32rpx;
}

.day-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.day-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.day-note {
  font-size: 22rpx;
  color: #9ca3af;
  margin-left: 14rpx;
}

/* 完成徽标 + 进度条 */
.day-badge {
  flex-shrink: 0;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 21rpx;
  border-radius: 10rpx;
  padding: 6rpx 16rpx;
  margin-left: 12rpx;
}

.day-badge-done {
  background: #ecfdf5;
  color: #059669;
}

.day-progress {
  height: 8rpx;
  background: #f3f4f6;
  border-radius: 4rpx;
  margin-top: 14rpx;
  overflow: hidden;
}

.day-progress-fill {
  height: 100%;
  background: #10b981;
  border-radius: 4rpx;
}

.day-items {
  margin-top: 16rpx;
  border-top: 1rpx solid #f9fafb;
  padding-top: 8rpx;
}

.day-item {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}

.day-item-name {
  font-size: 26rpx;
  color: #374151;
}

.day-item-sets {
  font-size: 24rpx;
  color: #6b7280;
}

.day-start {
  margin-top: 16rpx;
  background: #1d1d1f;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 500;
  border-radius: 14rpx;
  padding: 18rpx 0;
  text-align: center;
}

.day-start:active {
  opacity: 0.85;
}
