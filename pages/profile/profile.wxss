.page {
  padding: 20rpx;
  background: #f7f7f8;
  min-height: 100vh;
}

/* 授权引导弹窗 */
.auth-guide {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-guide-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.auth-guide-content {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  margin: 0 60rpx;
  z-index: 1001;
}

.auth-guide-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1d1d1f;
  text-align: center;
  margin-bottom: 20rpx;
}

.auth-guide-desc {
  font-size: 28rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.auth-guide-btns {
  display: flex;
  gap: 20rpx;
}

.auth-guide-btn {
  flex: 1;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 12rpx;
  border: none;
}

.auth-guide-btn::after {
  border: none;
}

.auth-guide-btn.cancel {
  background: #f3f4f6;
  color: #6b7280;
}

.auth-guide-btn.confirm {
  background: #07c160;
  color: #ffffff;
}

/* 用户信息卡片 */
.user-card {
  padding: 40rpx;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
  border: 4rpx solid #f0f0f0;
}

.user-detail {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #1d1d1f;
  display: block;
}

.user-id {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
  display: block;
}

.logout-btn {
  padding: 16rpx 32rpx;
  background: #f3f4f6;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.login-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.login-text {
  font-size: 28rpx;
  color: #9ca3af;
  margin-bottom: 30rpx;
}

.login-btn {
  background: #07c160;
  color: #ffffff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 8rpx;
  border: none;
}

.login-btn::after {
  border: none;
}

.auth-hint {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 20rpx;
}

/* 身体资料 */
.profile-info {
  margin-top: 20rpx;
}

.profile-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.profile-row:last-child {
  border-bottom: none;
}

.profile-label {
  font-size: 28rpx;
  color: #6b7280;
}

.profile-value {
  font-size: 28rpx;
  color: #1d1d1f;
  font-weight: 500;
}

.profile-empty {
  padding: 40rpx 0;
  text-align: center;
}

.profile-empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}

/* 功能菜单 */
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  font-size: 30rpx;
  color: #1d1d1f;
}

.menu-arrow {
  font-size: 32rpx;
  color: #d1d5db;
}

/* 应用信息 */
.app-info {
  text-align: center;
  padding: 40rpx;
  margin-top: 20rpx;
}

.app-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  display: block;
}

.app-version {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
  display: block;
}

.app-desc {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
  display: block;
}
