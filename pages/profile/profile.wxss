.page {
  padding: 20rpx;
  background: #f7f7f8;
  min-height: 100vh;
}

/* 用户信息卡片 */
.user-card {
  padding: 40rpx;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

/* 头像按钮 */
.avatar-btn {
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-btn.large {
  margin-bottom: 30rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
  border: 4rpx solid #f0f0f0;
  background: #f3f4f6;
}

.avatar.large {
  width: 160rpx;
  height: 160rpx;
  margin-right: 0;
  margin-bottom: 16rpx;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
  background: linear-gradient(135deg, #818cf8, #4f46e5);
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder.large {
  width: 160rpx;
  height: 160rpx;
  margin-right: 0;
  margin-bottom: 16rpx;
  font-size: 64rpx;
}

.avatar-hint {
  font-size: 24rpx;
  color: #9ca3af;
}

.user-detail {
  flex: 1;
}

/* 昵称输入 */
.nickname-input {
  font-size: 36rpx;
  font-weight: 600;
  color: #1d1d1f;
  padding: 8rpx 0;
  background: transparent;
}

.nickname-input::placeholder {
  color: #d1d5db;
}

.login-time {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
  display: block;
}

.logout-btn {
  padding: 16rpx 32rpx;
  background: #f3f4f6;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

/* 编辑表单 */
.edit-form {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.edit-header {
  margin-bottom: 30rpx;
}

.edit-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.input-group {
  width: 100%;
  margin-bottom: 40rpx;
}

.input-label {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
  display: block;
}

.input-group .nickname-input {
  width: 100%;
  padding: 20rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: normal;
  box-sizing: border-box;
}

.edit-btns {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.btn {
  flex: 1;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 12rpx;
  border: none;
}

.btn::after {
  border: none;
}

.btn.cancel {
  background: #f3f4f6;
  color: #6b7280;
}

.btn.confirm {
  background: #07c160;
  color: #ffffff;
}

/* 未登录状态 */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.login-hint {
  font-size: 28rpx;
  color: #9ca3af;
  margin: 20rpx 0 30rpx;
}

.quick-login {
  width: 100%;
}

.login-btn {
  background: #07c160;
  color: #ffffff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 8rpx;
  border: none;
  width: 100%;
  box-sizing: border-box;
}

.login-btn::after {
  border: none;
}

/* 身体资料 */
.profile-info {
  margin-top: 20rpx;
}

.profile-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.profile-row:last-child {
  border-bottom: none;
}

.profile-label {
  font-size: 28rpx;
  color: #6b7280;
}

.profile-value {
  font-size: 28rpx;
  color: #1d1d1f;
  font-weight: 500;
}

.profile-empty {
  padding: 40rpx 0;
  text-align: center;
}

.profile-empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}

/* 功能菜单 */
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 16rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  font-size: 30rpx;
  color: #1d1d1f;
}

.menu-arrow {
  font-size: 32rpx;
  color: #d1d5db;
}

/* 卡片通用样式 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

/* 应用信息 */
.app-info {
  text-align: center;
  padding: 40rpx;
  margin-top: 20rpx;
}

.app-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  display: block;
}

.app-version {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
  display: block;
}

.app-desc {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
  display: block;
}
