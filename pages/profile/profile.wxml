<view class="page">
  <!-- 用户信息卡片 -->
  <view class="card user-card">
    <!-- 已登录状态 -->
    <view class="user-info" wx:if="{{isLoggedIn && !isEditing}}">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{wxUser.avatarUrl}}" class="avatar" src="{{wxUser.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-placeholder">{{wxUser.nickName ? wxUser.nickName[0] : '?'}}</view>
      </button>
      <view class="user-detail">
        <input class="nickname-input" type="nickname" value="{{wxUser.nickName}}" placeholder="点击修改昵称" bindblur="onNicknameBlur" />
        <text class="login-time">已登录</text>
      </view>
      <view class="logout-btn" bindtap="onLogout">退出</view>
    </view>

    <!-- 编辑状态（未登录时选择头像后） -->
    <view class="edit-form" wx:elif="{{isEditing}}">
      <view class="edit-header">
        <text class="edit-title">设置用户信息</text>
      </view>
      <button class="avatar-btn large" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{editAvatarUrl}}" class="avatar large" src="{{editAvatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-placeholder large">?</view>
        <text class="avatar-hint">点击选择头像</text>
      </button>
      <view class="input-group">
        <text class="input-label">昵称</text>
        <input class="nickname-input" type="nickname" placeholder="请输入昵称" value="{{editNickName}}" bindinput="onNicknameInput" />
      </view>
      <view class="edit-btns">
        <button class="btn cancel" bindtap="onCancelEdit">取消</button>
        <button class="btn confirm" bindtap="onSaveUser">保存</button>
      </view>
    </view>

    <!-- 未登录状态 -->
    <view class="login-prompt" wx:else>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <view class="avatar-placeholder">?</view>
      </button>
      <text class="login-hint">选择头像并设置昵称</text>
      <view class="quick-login">
        <button class="login-btn" bindtap="onQuickLogin">快速设置</button>
      </view>
    </view>
  </view>

  <!-- 身体资料 -->
  <view class="card" bindtap="onEditProfile">
    <view class="card-title">身体资料</view>
    <view class="profile-info" wx:if="{{profile}}">
      <view class="profile-row">
        <text class="profile-label">性别</text>
        <text class="profile-value">{{profile.gender === 'male' ? '男' : '女'}}</text>
      </view>
      <view class="profile-row">
        <text class="profile-label">年龄</text>
        <text class="profile-value">{{profile.age}} 岁</text>
      </view>
      <view class="profile-row">
        <text class="profile-label">身高</text>
        <text class="profile-value">{{profile.heightCm}} cm</text>
      </view>
      <view class="profile-row">
        <text class="profile-label">体重</text>
        <text class="profile-value">{{profile.weightKg}} kg</text>
      </view>
    </view>
    <view class="profile-empty" wx:else>
      <text class="profile-empty-text">点击设置身体资料</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="card">
    <view class="card-title">功能</view>
    <view class="menu-item" bindtap="onDataManage">
      <text class="menu-text">数据管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onExport">
      <text class="menu-text">数据导出</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onPrivacy">
      <text class="menu-text">隐私说明</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 应用信息 -->
  <view class="card app-info">
    <text class="app-name">铁馆日志</text>
    <text class="app-version">v1.0.0</text>
    <text class="app-desc">专业健身训练记录工具</text>
  </view>
</view>
