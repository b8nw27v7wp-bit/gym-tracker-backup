.page {
  padding-bottom: 200rpx;
}

/* ========== 页头 ========== */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 48rpx 48rpx 20rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.date-row {
  display: flex;
  align-items: baseline;
}

.date {
  font-size: 52rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: 1rpx;
}

.week-badge {
  margin-left: 16rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

.sub {
  font-size: 25rpx;
  color: #9ca3af;
  margin-top: 10rpx;
}

.header-right {
  display: flex;
  gap: 16rpx;
}

.history-entry {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  font-size: 25rpx;
  color: #374151;
  box-shadow: 0 2rpx 12rpx rgba(17, 24, 39, 0.05);
}

.history-entry:active {
  background: #f9fafb;
}

.history-arrow {
  margin-left: 10rpx;
  color: #9ca3af;
  font-size: 28rpx;
  line-height: 1;
}

/* ========== 计时条 ========== */
.timer-bar {
  display: flex;
  align-items: center;
  margin: 8rpx 32rpx 0;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 20rpx;
  padding: 18rpx 28rpx;
}

.timer-icon {
  margin-right: 14rpx;
  font-size: 30rpx;
}

.timer-text {
  font-size: 25rpx;
  color: #92400e;
  font-weight: 500;
}

/* ========== 搜索 ========== */
.search-mini {
  display: flex;
  align-items: center;
  background: #f9fafb;
  border-radius: 20rpx;
  padding: 0 28rpx;
  transition: box-shadow 0.2s;
}

.search-mini:focus-within {
  box-shadow: 0 0 0 3rpx rgba(17, 24, 39, 0.06);
}

.search-mini-input {
  flex: 1;
  font-size: 27rpx;
  padding: 20rpx 0;
  height: auto;
  min-height: 44rpx;
}

.search-clear {
  color: #9ca3af;
  font-size: 28rpx;
  padding: 12rpx;
}

/* ========== 部位选择 ========== */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-count {
  font-size: 22rpx;
  color: #9ca3af;
  font-variant-numeric: tabular-nums;
}

.muscle-row {
  display: flex;
  flex-wrap: wrap;
  margin: 4rpx -8rpx 0;
}

.muscle-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 140rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #f3f4f6;
  margin: 0 8rpx 16rpx;
  font-size: 26rpx;
  color: #374151;
  box-shadow: 0 2rpx 10rpx rgba(17, 24, 39, 0.04);
  transition: all 0.15s;
  box-sizing: border-box;
}

.muscle-chip:active {
  transform: scale(0.96);
}

.muscle-chip.chip-active {
  background: #1d1d1f;
  border-color: #1d1d1f;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(17, 24, 39, 0.18);
}

.muscle-icon {
  font-size: 46rpx;
  margin-bottom: 10rpx;
  line-height: 1;
}

/* ========== 动作网格（两列文字卡） ========== */
.exercise-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 8rpx -8rpx 0;
}

.exercise-item {
  width: 48.4%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  margin: 0 8rpx 16rpx;
  background: #ffffff;
  border: 1rpx solid #f1f2f4;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 1rpx 6rpx rgba(17, 24, 39, 0.03);
  transition: all 0.15s ease;
}

.exercise-item:active {
  background: #f7f7f8;
  border-color: #e5e7eb;
  transform: scale(0.98);
}

.exercise-name {
  font-size: 27rpx;
  font-weight: 500;
  color: #1d1d1f;
  letter-spacing: 0.5rpx;
  line-height: 1.4;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 难度评级点（1-3 个点亮） */
.exercise-dots {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  gap: 8rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #e8eaed;
  transition: background 0.15s;
}

.dot-on {
  background: #1d1d1f;
}

/* ========== 组编辑 ========== */
.edit-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.edit-head-right {
  display: flex;
  align-items: center;
}

.edit-close {
  color: #d1d5db;
  font-size: 34rpx;
  padding: 8rpx 4rpx 8rpx 20rpx;
}

.edit-close:active {
  color: #ef4444;
}

.set-head {
  display: flex;
  padding: 12rpx 0;
  color: #9ca3af;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.set-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}

/* 组行列宽 */
.set-c-no { width: 8%; }
.set-c-warm { width: 9%; }
.set-c-w { width: 19%; }
.set-c-x { width: 6%; }
.set-c-r { width: 19%; }
.set-c-rpe { width: 19%; }
.set-c-del { width: 9%; }

.set-col {
  text-align: center;
}

.set-no {
  font-size: 26rpx;
  color: #9ca3af;
  font-weight: 500;
}

.set-input {
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 14rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  color: #1d1d1f;
  text-align: center;
  height: auto;
  min-height: 52rpx;
}

.set-input-rpe {
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 400;
}

.set-x {
  color: #d1d5db;
  font-size: 24rpx;
}

.set-del {
  color: #d1d5db;
  font-size: 30rpx;
  padding: 12rpx;
}

.set-del:active {
  color: #ef4444;
}

/* 热身开关 */
.warm-btn {
  font-size: 22rpx;
  color: #c4c8cf;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  line-height: 42rpx;
  height: 42rpx;
  width: 46rpx;
  margin: 0 auto;
  transition: all 0.15s;
}

.warm-on {
  background: #ffedd5;
  border-color: #fdba74;
  color: #ea580c;
  font-weight: 700;
}

.set-tip {
  font-size: 21rpx;
  color: #9ca3af;
  padding: 16rpx 0 20rpx;
  line-height: 1.6;
}

/* ========== 已添加动作 ========== */
.draft-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.draft-count {
  font-size: 22rpx;
  color: #9ca3af;
  background: #f3f4f6;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

.added-row {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid #f9fafb;
}

.added-row:active {
  background: #fafafa;
}

.added-index {
  width: 44rpx;
  height: 44rpx;
  background: #f3f4f6;
  color: #6b7280;
  border-radius: 50%;
  font-size: 23rpx;
  font-weight: 600;
  text-align: center;
  line-height: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.added-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.added-name {
  font-size: 28rpx;
  color: #1d1d1f;
  font-weight: 500;
}

.added-sub {
  font-size: 23rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.added-right {
  display: flex;
  align-items: center;
}

.added-tag {
  background: #eef2ff;
  color: #4f46e5;
  font-size: 21rpx;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  margin-right: 16rpx;
}

.added-del {
  color: #d1d5db;
  font-size: 32rpx;
  padding: 12rpx;
}

.added-del:active {
  color: #ef4444;
}

/* ========== 备注输入 ========== */
.note-wrap {
  margin-top: 28rpx;
}

.note-input {
  width: 100%;
  background: #f9fafb;
  border-radius: 18rpx;
  padding: 22rpx 26rpx;
  font-size: 26rpx;
  color: #1d1d1f;
  min-height: 88rpx;
  box-sizing: border-box;
  line-height: 1.7;
}

/* ========== 底部保存栏 ========== */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(17, 24, 39, 0.06);
}

.footer-summary {
  display: flex;
  flex-direction: column;
}

.footer-vol {
  font-size: 44rpx;
  letter-spacing: 1rpx;
}

.footer-sub {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 2rpx;
}

.save-btn {
  background: #1d1d1f;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 22rpx 72rpx;
  box-shadow: 0 8rpx 20rpx rgba(17, 24, 39, 0.2);
  transition: all 0.15s;
}

.save-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}
