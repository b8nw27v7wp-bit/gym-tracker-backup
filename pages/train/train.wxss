.page {
  padding-bottom: 240rpx;
}

/* ========== 页头 ========== */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 48rpx 48rpx 20rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.date-row {
  display: flex;
  align-items: baseline;
}

.date {
  font-size: 52rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: 1rpx;
}

.week-badge {
  margin-left: 16rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

.sub {
  font-size: 25rpx;
  color: #9ca3af;
  margin-top: 10rpx;
}

.header-right {
  display: flex;
  gap: 16rpx;
}

.history-entry {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  font-size: 25rpx;
  color: #374151;
  box-shadow: 0 2rpx 12rpx rgba(17, 24, 39, 0.05);
}

.history-entry:active {
  background: #f9fafb;
}

.history-arrow {
  width: 13rpx;
  height: 13rpx;
  border-top: 2.5rpx solid #9ca3af;
  border-right: 2.5rpx solid #9ca3af;
  transform: rotate(45deg);
  margin-left: 12rpx;
  border-radius: 1rpx;
}

.history-entry:active .history-arrow {
  border-color: #4b5563;
}

/* ========== 本周计划提醒条 ========== */
.plan-reminder {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 32rpx 0;
  background: linear-gradient(90deg, #f5f6ff 0%, #ffffff 100%);
  border: 1rpx solid #e0e7ff;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
}

.plan-reminder-hover {
  background: #eef2ff;
}

.plan-reminder-left {
  display: flex;
  flex-direction: column;
}

.plan-reminder-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #1d1d1f;
}

.plan-reminder-sub {
  font-size: 21rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.plan-reminder-btn {
  font-size: 24rpx;
  color: #ffffff;
  background: #4f46e5;
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
  flex-shrink: 0;
}

/* ========== 编辑历史训练模式条（v5） ========== */
.edit-mode-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 32rpx 0;
  background: #fef3c7;
  border: 1rpx solid #fde68a;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
}

.edit-mode-left {
  display: flex;
  flex-direction: column;
}

.edit-mode-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #1d1d1f;
}

.edit-mode-sub {
  font-size: 21rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.edit-mode-cancel {
  font-size: 23rpx;
  color: #b45309;
  flex-shrink: 0;
  padding: 10rpx 0 10rpx 24rpx;
}

/* ========== 复制上次训练条（v5） ========== */
.repeat-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 32rpx 0;
  background: linear-gradient(90deg, #f0fdf4 0%, #ffffff 100%);
  border: 1rpx solid #bbf7d0;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
}

.repeat-bar-hover {
  background: #ecfdf5;
}

.repeat-left {
  display: flex;
  flex-direction: column;
}

.repeat-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #1d1d1f;
}

.repeat-sub {
  font-size: 21rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.repeat-btn {
  font-size: 24rpx;
  color: #047857;
  background: #d1fae5;
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
  flex-shrink: 0;
}

/* ========== 计时条 ========== */
.timer-bar {
  display: flex;
  align-items: center;
  margin: 8rpx 32rpx 0;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 20rpx;
  padding: 18rpx 28rpx;
}

.timer-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d97706;
  margin-right: 14rpx;
  animation: timer-pulse 1.2s ease-in-out infinite;
}

@keyframes timer-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

.timer-dot-paused {
  background: #9ca3af;
  animation: none;
}

.timer-text {
  font-size: 25rpx;
  color: #92400e;
  font-weight: 500;
  flex: 1;
}

.timer-pause {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d97706;
  margin-left: 16rpx;
  border: 1rpx solid #fde68a;
}

.timer-pause:active {
  background: #fef3c7;
}

/* 播放/暂停图标 */
.icon-pause::before,
.icon-pause::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 5rpx;
  height: 18rpx;
  background: currentColor;
  border-radius: 2rpx;
  transform: translateY(-50%);
}

.icon-pause::before {
  left: 30%;
}

.icon-pause::after {
  right: 30%;
}

.icon-play::before {
  content: '';
  position: absolute;
  left: 36%;
  top: 50%;
  width: 0;
  height: 0;
  border-left: 16rpx solid currentColor;
  border-top: 9rpx solid transparent;
  border-bottom: 9rpx solid transparent;
  transform: translateY(-50%);
}

/* ========== 组间休息倒计时 ========== */
.rest-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 32rpx 0;
  background: #1d1d1f;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
}

.rest-left {
  display: flex;
  align-items: baseline;
}

.rest-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #ffffff;
  font-variant-numeric: tabular-nums;
  min-width: 100rpx;
  transition: color 0.3s;
}

.rest-num-almost {
  color: #fca5a5;
}

.rest-unit {
  font-size: 24rpx;
  color: #9ca3af;
  margin-left: 8rpx;
}

.rest-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rest-chip {
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}

.rest-chip:active {
  background: rgba(255, 255, 255, 0.22);
}

.rest-stop {
  color: #9ca3af;
  font-size: 24rpx;
  padding: 12rpx 16rpx;
}

/* 休息快捷入口（常驻，未计时时显示） */
.rest-quick {
  display: flex;
  flex-direction: column;
  margin: 16rpx 32rpx 0;
  background: #ffffff;
  border: 1rpx solid #f1f2f4;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  box-shadow: 0 1rpx 6rpx rgba(17, 24, 39, 0.03);
}

.rest-quick-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.rest-quick-label {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
  flex-shrink: 0;
}

/* 推荐提示文案（热身组/正式组） */
.rest-quick-recommend {
  font-size: 20rpx;
  color: #4f46e5;
  margin-left: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rest-quick-chips {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.rest-chip-wrap {
  position: relative;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.rest-chip-dark {
  background: #f3f4f6;
  color: #374151;
  padding: 10rpx 22rpx;
}

.rest-chip-dark:active {
  background: #e5e7eb;
}

/* 推荐高亮 */
.rest-chip-recommend {
  background: #eef2ff;
  color: #4f46e5;
  border: 1rpx solid #c7d2fe;
  font-weight: 600;
}

.rest-recommend-badge {
  position: absolute;
  top: -14rpx;
  right: -8rpx;
  background: #4f46e5;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 1;
  padding: 4rpx 8rpx;
  border-radius: 999rpx;
}

.rest-custom-input {
  width: 90rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 24rpx;
  padding: 10rpx 14rpx;
  height: auto;
  min-height: 40rpx;
  text-align: center;
  margin-left: 4rpx;
  color: #1d1d1f;
}

.rest-custom-go {
  background: #1d1d1f;
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  margin-left: 10rpx;
  flex-shrink: 0;
}

.rest-custom-go:active {
  opacity: 0.85;
}

/* 暂停中的子文案 */
.timer-paused-sub {
  color: #9ca3af;
  font-weight: 400;
}

/* ========== 搜索 ========== */
.search-mini {
  display: flex;
  align-items: center;
  background: #f9fafb;
  border-radius: 20rpx;
  padding: 0 28rpx;
  transition: box-shadow 0.2s;
}

.search-mini:focus-within {
  box-shadow: 0 0 0 3rpx rgba(17, 24, 39, 0.06);
}

.search-mini-input {
  flex: 1;
  font-size: 27rpx;
  padding: 20rpx 0;
  height: auto;
  min-height: 44rpx;
}

.search-clear {
  color: #9ca3af;
  padding: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

/* ========== CSS 线性图标（纯样式，无图片依赖） ========== */
.icon {
  position: relative;
  display: inline-block;
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.icon::before,
.icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 66%;
  height: 2.5rpx;
  background: currentColor;
  border-radius: 2rpx;
  transform: translate(-50%, -50%);
}

/* ×（关闭/删除） */
.icon-x::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.icon-x::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* ＋（添加） */
.icon-plus::before {
  transform: translate(-50%, -50%);
}

.icon-plus::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

/* ========== 部位选择 ========== */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-count {
  font-size: 22rpx;
  color: #9ca3af;
  font-variant-numeric: tabular-nums;
}

.muscle-row {
  display: flex;
  flex-wrap: wrap;
  margin: 4rpx -8rpx 0;
}

.muscle-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 140rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #f3f4f6;
  margin: 0 8rpx 16rpx;
  font-size: 26rpx;
  color: #374151;
  box-shadow: 0 2rpx 10rpx rgba(17, 24, 39, 0.04);
  transition: all 0.15s;
  box-sizing: border-box;
}

.muscle-chip:active {
  transform: scale(0.96);
}

.muscle-chip.chip-active {
  background: #1d1d1f;
  border-color: #1d1d1f;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(17, 24, 39, 0.18);
}

.muscle-icon {
  font-size: 46rpx;
  margin-bottom: 10rpx;
  line-height: 1;
}

/* ========== 动作网格（两列文字卡） ========== */
.exercise-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 8rpx -8rpx 0;
}

.exercise-item {
  width: 48.4%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  margin: 0 8rpx 16rpx;
  background: #ffffff;
  border: 1rpx solid #f1f2f4;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 1rpx 6rpx rgba(17, 24, 39, 0.03);
  transition: all 0.15s ease;
}

.exercise-item:active {
  background: #f7f7f8;
  border-color: #e5e7eb;
  transform: scale(0.98);
}

.exercise-name {
  font-size: 27rpx;
  font-weight: 500;
  color: #1d1d1f;
  letter-spacing: 0.5rpx;
  line-height: 1.4;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 上次记录提示（添加时预填） */
.exercise-last {
  font-size: 20rpx;
  color: #4f46e5;
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
}

/* 训练智能：渐进超负荷建议（本次建议重量/次数） */
.exercise-suggest {
  font-size: 20rpx;
  color: #10b981;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.5;
}

/* 训练智能：动作轮换提醒（连续使用建议换动作） */
.exercise-rotation {
  font-size: 19rpx;
  color: #b45309;
  margin-top: 4rpx;
  line-height: 1.5;
}

/* 难度评级点（1-3 个点亮） */
.exercise-dots {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  gap: 8rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #e8eaed;
  transition: background 0.15s;
}

.dot-on {
  background: #1d1d1f;
}

/* ========== 已添加动作 ========== */
.draft-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.draft-count {
  font-size: 22rpx;
  color: #9ca3af;
  background: #f3f4f6;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

.added-row {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid #f9fafb;
}

.added-row:active {
  background: #fafafa;
}

.added-index {
  width: 44rpx;
  height: 44rpx;
  background: #f3f4f6;
  color: #6b7280;
  border-radius: 50%;
  font-size: 23rpx;
  font-weight: 600;
  text-align: center;
  line-height: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.added-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.added-name {
  font-size: 28rpx;
  color: #1d1d1f;
  font-weight: 500;
}

.added-sub {
  font-size: 23rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.added-right {
  display: flex;
  align-items: center;
}

/* 排序按钮（上移/下移） */
.added-move {
  display: flex;
  flex-direction: column;
  margin-right: 14rpx;
}

.move-btn {
  width: 40rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c4c8cf;
}

.move-btn:active {
  color: #6b7280;
}

.move-btn-disabled {
  opacity: 0.25;
}

.icon-arrow-up::before,
.icon-arrow-down::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  border-top: 2.5rpx solid currentColor;
  border-left: 2.5rpx solid currentColor;
}

.icon-arrow-up::before {
  transform: translate(-50%, -40%) rotate(45deg);
}

.icon-arrow-down::before {
  transform: translate(-50%, -60%) rotate(225deg);
}

.added-tag {
  background: #eef2ff;
  color: #4f46e5;
  font-size: 21rpx;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  margin-right: 16rpx;
}

.added-del {
  color: #d1d5db;
  padding: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.added-del .icon {
  width: 30rpx;
  height: 30rpx;
}

.added-del:active {
  color: #ef4444;
}

.btn-ghost-add {
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-ghost-add .icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

/* ========== 备注输入 ========== */
.note-wrap {
  margin-top: 28rpx;
}

.note-input {
  width: 100%;
  background: #f9fafb;
  border-radius: 18rpx;
  padding: 22rpx 26rpx;
  font-size: 26rpx;
  color: #1d1d1f;
  min-height: 88rpx;
  box-sizing: border-box;
  line-height: 1.7;
}

/* ========== 底部保存栏 ========== */
/* bottom 让出自定义 tabBar 高度（tabBar 内容约 100rpx + 安全区），避免被遮挡 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(17, 24, 39, 0.06);
  z-index: 100; /* 低于 tabBar(999)，高于页面内容 */
}

.footer-summary {
  display: flex;
  flex-direction: column;
}

.footer-vol {
  font-size: 44rpx;
  letter-spacing: 1rpx;
}

.footer-sub {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 2rpx;
}

.save-btn {
  background: #1d1d1f;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 22rpx 72rpx;
  box-shadow: 0 8rpx 20rpx rgba(17, 24, 39, 0.2);
  transition: all 0.15s;
}

.save-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

/* ========== Tabata 计时器 ========== */
.tabata-section {
  margin-bottom: 20rpx;
}

.tabata-card {
  padding: 32rpx;
}

.tabata-form {
  margin-top: 20rpx;
}

.tabata-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.tabata-label {
  font-size: 28rpx;
  color: #374151;
}

.tabata-input-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tabata-input {
  width: 100rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 12rpx;
}

.tabata-unit {
  font-size: 24rpx;
  color: #9ca3af;
  width: 40rpx;
}

.tabata-preview {
  margin-top: 20rpx;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  text-align: center;
}

.tabata-preview text {
  font-size: 24rpx;
  color: #6b7280;
}

.tabata-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.tabata-save-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 20rpx 0;
}

.tabata-start-btn {
  flex: 2;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background: #ef4444;
  border-radius: 12rpx;
  padding: 20rpx 0;
}

/* Tabata 运行中 */
.tabata-running {
  background: #1d1d1f;
  color: #ffffff;
  text-align: center;
}

.tabata-phase {
  font-size: 28rpx;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.tabata-phase-work {
  color: #ef4444;
}

.tabata-phase-rest {
  color: #22c55e;
}

.tabata-phase-cycleRest {
  color: #f59e0b;
}

.tabata-timer {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin: 24rpx 0;
}

.tabata-time-num {
  font-size: 120rpx;
  font-weight: 700;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.tabata-time-unit {
  font-size: 32rpx;
  margin-left: 8rpx;
  opacity: 0.7;
}

