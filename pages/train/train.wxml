<view class="page">
  <!-- 页头 -->
  <view class="header">
    <view class="header-left">
      <view class="date-row">
        <text class="date">{{todayDate}}</text>
        <text class="week-badge">{{todayWeek}}</text>
      </view>
      <view class="sub">今天练了什么？记录下来</view>
    </view>
    <view class="header-right">
      <view class="history-entry" bindtap="onGoPlans">
        <text>计划</text>
        <view class="history-arrow"></view>
      </view>
      <view class="history-entry" bindtap="onGoHistory">
        <text>历史</text>
        <view class="history-arrow"></view>
      </view>
    </view>
  </view>

  <!-- 本周计划今日提醒 -->
  <view class="plan-reminder" wx:if="{{planReminder}}" hover-class="plan-reminder-hover" bindtap="onFillReminder">
    <view class="plan-reminder-left">
      <text class="plan-reminder-title">{{planReminder.planName}} · 今日训练日 {{planReminder.dayName}}</text>
      <text class="plan-reminder-sub">本周计划 · 点击一键填充</text>
    </view>
    <view class="plan-reminder-btn">开始</view>
  </view>

  <!-- 编辑历史训练模式条（v5） -->
  <view class="edit-mode-bar" wx:if="{{editWorkoutId}}">
    <view class="edit-mode-left">
      <text class="edit-mode-title">编辑模式</text>
      <text class="edit-mode-sub">保存后将更新该条历史记录（保留原时间）</text>
    </view>
    <view class="edit-mode-cancel" bindtap="onCancelEditWorkout">放弃编辑</view>
  </view>

  <!-- 复制上次训练快捷条（v5，对标 Hevy Repeat） -->
  <view class="repeat-bar" wx:if="{{lastWorkoutInfo && draft.length === 0 && !editWorkoutId}}" hover-class="repeat-bar-hover" bindtap="onRepeatLast">
    <view class="repeat-left">
      <text class="repeat-title">重复上次训练</text>
      <text class="repeat-sub">{{lastWorkoutInfo.date}} · {{lastWorkoutInfo.exerciseCount}} 个动作 · {{lastWorkoutInfo.volume}} {{unitLabel}}</text>
    </view>
    <view class="repeat-btn">复制</view>
  </view>

  <!-- 训练计时 -->
  <view class="timer-bar" wx:if="{{sessionStarted}}">
    <view class="timer-dot {{sessionPaused ? 'timer-dot-paused' : ''}}"></view>
    <text class="timer-text">{{sessionPaused ? '已暂停' : '本次训练已进行'}} {{sessionMinutes}} 分钟<text wx:if="{{sessionPaused && pausedMinutes > 0}}" class="timer-paused-sub"> · 已暂停 {{pausedMinutes}} 分钟</text></text>
    <view class="timer-pause" bindtap="onTogglePause">
      <view class="icon {{sessionPaused ? 'icon-play' : 'icon-pause'}}"></view>
    </view>
  </view>

  <!-- 组间休息倒计时 -->
  <view class="rest-bar" wx:if="{{restRunning || restRemaining > 0}}">
    <view class="rest-left">
      <text class="rest-num {{restAlmostDone ? 'rest-num-almost' : ''}}">{{restRemaining}}</text>
      <text class="rest-unit">秒</text>
    </view>
    <view class="rest-right">
      <view class="rest-chip" data-secs="30" bindtap="onRestStart">30s</view>
      <view class="rest-chip" data-secs="60" bindtap="onRestStart">60s</view>
      <view class="rest-chip" data-secs="90" bindtap="onRestStart">90s</view>
      <view class="rest-chip" data-secs="120" bindtap="onRestStart">120s</view>
      <view class="rest-stop" bindtap="stopRestTimer">停止</view>
    </view>
  </view>

  <!-- 休息计时快捷入口（未计时时显示，含自定义秒数） -->
  <view class="rest-quick" wx:if="{{!restRunning && restRemaining === 0}}">
    <view class="rest-quick-head">
      <text class="rest-quick-label">组间休息</text>
      <text class="rest-quick-recommend" wx:if="{{restRecommendSecs > 0}}">{{restRecommendLabel}}</text>
    </view>
    <view class="rest-quick-chips">
      <view class="rest-chip-wrap">
        <view class="rest-chip rest-chip-dark {{restRecommendSecs === 30 ? 'rest-chip-recommend' : ''}}" data-secs="30" bindtap="onRestStart">30s</view>
        <text wx:if="{{restRecommendSecs === 30}}" class="rest-recommend-badge">推荐</text>
      </view>
      <view class="rest-chip-wrap">
        <view class="rest-chip rest-chip-dark {{restRecommendSecs === 60 ? 'rest-chip-recommend' : ''}}" data-secs="60" bindtap="onRestStart">60s</view>
        <text wx:if="{{restRecommendSecs === 60}}" class="rest-recommend-badge">推荐</text>
      </view>
      <view class="rest-chip-wrap">
        <view class="rest-chip rest-chip-dark {{restRecommendSecs === 90 ? 'rest-chip-recommend' : ''}}" data-secs="90" bindtap="onRestStart">90s</view>
        <text wx:if="{{restRecommendSecs === 90}}" class="rest-recommend-badge">推荐</text>
      </view>
      <view class="rest-chip-wrap">
        <view class="rest-chip rest-chip-dark {{restRecommendSecs === 120 ? 'rest-chip-recommend' : ''}}" data-secs="120" bindtap="onRestStart">120s</view>
        <text wx:if="{{restRecommendSecs === 120}}" class="rest-recommend-badge">推荐</text>
      </view>
      <input
        class="rest-custom-input"
        type="number"
        value="{{restCustomSecs}}"
        bindinput="onRestCustomInput"
        placeholder="秒"
      />
      <view class="rest-custom-go" bindtap="onRestCustomStart">开始</view>
    </view>
  </view>

  <!-- Tabata 计时器面板 -->
  <view class="tabata-section" wx:if="{{showTabataPanel}}">
    <!-- Tabata 设置 -->
    <view class="card tabata-card" wx:if="{{!tabataRunning}}">
      <view class="card-title">Tabata 设置</view>
      <view class="tabata-form">
        <view class="tabata-row">
          <text class="tabata-label">运动时间</text>
          <view class="tabata-input-wrap">
            <input class="tabata-input" type="number" value="{{tabataSettings.workSecs}}" data-field="workSecs" bindinput="onTabataInput" />
            <text class="tabata-unit">秒</text>
          </view>
        </view>
        <view class="tabata-row">
          <text class="tabata-label">休息时间</text>
          <view class="tabata-input-wrap">
            <input class="tabata-input" type="number" value="{{tabataSettings.restSecs}}" data-field="restSecs" bindinput="onTabataInput" />
            <text class="tabata-unit">秒</text>
          </view>
        </view>
        <view class="tabata-row">
          <text class="tabata-label">轮数</text>
          <view class="tabata-input-wrap">
            <input class="tabata-input" type="number" value="{{tabataSettings.rounds}}" data-field="rounds" bindinput="onTabataInput" />
            <text class="tabata-unit">轮</text>
          </view>
        </view>
        <view class="tabata-row">
          <text class="tabata-label">组数</text>
          <view class="tabata-input-wrap">
            <input class="tabata-input" type="number" value="{{tabataSettings.cycles}}" data-field="cycles" bindinput="onTabataInput" />
            <text class="tabata-unit">组</text>
          </view>
        </view>
        <view class="tabata-row" wx:if="{{tabataSettings.cycles > 1}}">
          <text class="tabata-label">组间休息</text>
          <view class="tabata-input-wrap">
            <input class="tabata-input" type="number" value="{{tabataSettings.cycleRestSecs}}" data-field="cycleRestSecs" bindinput="onTabataInput" />
            <text class="tabata-unit">秒</text>
          </view>
        </view>
      </view>
      <view class="tabata-preview">
        <text>总计 {{tabataSettings.rounds * tabataSettings.cycles}} 轮 · 约 {{Math.round((tabataSettings.workSecs + tabataSettings.restSecs) * tabataSettings.rounds * tabataSettings.cycles / 60)}} 分钟</text>
      </view>
      <view class="tabata-btns">
        <view class="tabata-save-btn" bindtap="onSaveTabataSettings">保存设置</view>
        <view class="tabata-start-btn" bindtap="onToggleTabata">开始 Tabata</view>
      </view>
    </view>

    <!-- Tabata 计时器运行中 -->
    <view class="card tabata-card tabata-running" wx:if="{{tabataRunning}}">
      <view class="tabata-phase tabata-phase-{{tabataPhase}}">
        {{tabataPhase === 'work' ? '运动' : tabataPhase === 'rest' ? '休息' : '组间休息'}}
      </view>
      <view class="tabata-timer">
        <text class="tabata-time-num">{{tabataRemaining}}</text>
        <text class="tabata-time-unit">秒</text>
      </view>
      <view class="tabata-progress">
        <text>第 {{tabataRound}} / {{tabataSettings.rounds}} 轮</text>
        <text wx:if="{{tabataSettings.cycles > 1}}"> · 第 {{tabataCycle}} / {{tabataSettings.cycles}} 组</text>
      </view>
      <view class="tabata-stop-btn" bindtap="onToggleTabata">停止</view>
    </view>
  </view>

  <!-- Tabata 快捷入口（面板关闭时显示） -->
  <view class="tabata-quick" wx:if="{{!showTabataPanel}}" bindtap="onToggleTabataPanel">
    <view class="tabata-quick-icon">⏱</view>
    <text class="tabata-quick-text">Tabata 计时器</text>
    <view class="tabata-quick-arrow">›</view>
  </view>

  <!-- 选部位 + 选动作 -->
  <view class="card" wx:if="{{step === 'pick'}}">
    <view class="search-mini">
      <input
        class="search-mini-input"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        placeholder="搜索动作快速添加"
        confirm-type="search"
      />
      <view wx:if="{{searchKeyword}}" class="search-clear" bindtap="onClearSearch">
        <view class="icon icon-x"></view>
      </view>
    </view>

    <block wx:if="{{!searchKeyword}}">
      <view class="card-title" style="margin-top: 20rpx;">选择训练部位</view>
      <view class="muscle-row">
        <view
          wx:for="{{muscles}}"
          wx:key="key"
          class="muscle-chip {{currentMuscle === item.key ? 'chip-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onPickMuscle"
        >
          <text class="muscle-icon">{{item.icon}}</text>
          <text>{{item.name}}</text>
        </view>
      </view>
      <view class="lib-entry" hover-class="lib-entry-hover" bindtap="onGoLibrary">
        <view class="lib-entry-left">
          <text class="lib-entry-title">在动作库查看「{{currentMuscleName}}」全部动作</text>
          <text class="lib-entry-sub">含动作详情 · 部位训练指南</text>
        </view>
        <view class="lib-entry-arrow"></view>
      </view>
      <view class="section-head" style="margin-top: 24rpx;">
        <text class="card-title" style="margin:0;">选择动作</text>
        <text class="section-count">{{exerciseList.length}}</text>
      </view>
      <view class="exercise-grid">
        <view
          wx:for="{{exerciseList}}"
          wx:key="id"
          class="exercise-item"
          data-id="{{item.id}}"
          bindtap="onAddExercise"
        >
          <text class="exercise-name">{{item.name}}</text>
          <text wx:if="{{item.lastText}}" class="exercise-last">{{item.lastText}}</text>
          <text wx:if="{{item.suggestText}}" class="exercise-suggest">{{item.suggestText}}</text>
          <text wx:if="{{item.rotationText}}" class="exercise-rotation">{{item.rotationText}}</text>
          <view class="exercise-dots">
            <view class="dot {{item.difficulty >= 1 ? 'dot-on' : ''}}"></view>
            <view class="dot {{item.difficulty >= 2 ? 'dot-on' : ''}}"></view>
            <view class="dot {{item.difficulty >= 3 ? 'dot-on' : ''}}"></view>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="card-title" style="margin-top: 20rpx;">搜索结果（{{exerciseList.length}}）</view>
      <view class="exercise-grid">
        <view
          wx:for="{{exerciseList}}"
          wx:key="id"
          class="exercise-item"
          data-id="{{item.id}}"
          bindtap="onAddExercise"
        >
          <text class="exercise-name">{{item.name}}</text>
          <text wx:if="{{item.lastText}}" class="exercise-last">{{item.lastText}}</text>
          <text wx:if="{{item.suggestText}}" class="exercise-suggest">{{item.suggestText}}</text>
          <text wx:if="{{item.rotationText}}" class="exercise-rotation">{{item.rotationText}}</text>
          <view class="exercise-dots">
            <view class="dot {{item.difficulty >= 1 ? 'dot-on' : ''}}"></view>
            <view class="dot {{item.difficulty >= 2 ? 'dot-on' : ''}}"></view>
            <view class="dot {{item.difficulty >= 3 ? 'dot-on' : ''}}"></view>
          </view>
        </view>
      </view>
      <view class="btn-ghost" bindtap="onClearSearch">清除搜索，返回部位选择</view>
    </block>
  </view>

  <!-- 组编辑卡片（set-editor 组件） -->
  <set-editor
    wx:if="{{step === 'edit'}}"
    exercise-name="{{editing.exerciseName}}"
    muscle-name="{{editingMuscleName}}"
    sets="{{editing.sets}}"
    unit="{{unitLabel}}"
    last-prefill="{{editing.lastPrefillText}}"
    bind:togglewarmup="onToggleWarmup"
    bind:weightinput="onWeightInput"
    bind:repsinput="onRepsInput"
    bind:rpeinput="onRpeInput"
    bind:removeset="onRemoveSet"
    bind:addset="onAddSet"
    bind:done="onDoneEdit"
    bind:close="onBackToPick"
    bind:clearprefill="onClearPrefill"
  />

  <!-- 本次已添加动作 -->
  <view class="card" wx:if="{{draft.length > 0}}">
    <view class="draft-head">
      <view class="card-title" style="margin:0;">本次训练</view>
      <text class="draft-count">{{draft.length}} 个动作</text>
    </view>
    <view
      wx:for="{{draft}}"
      wx:key="exerciseId"
      class="added-row"
      data-index="{{index}}"
      bindtap="onEditItem"
    >
      <view class="added-index">{{index + 1}}</view>
      <view class="added-info">
        <text class="added-name">{{item.exerciseName}}</text>
        <text class="added-sub">{{item.sets.length}} 组 · 容量 {{itemVolumes[index]}} {{unitLabel}}</text>
      </view>
      <view class="added-right">
        <view class="added-move">
          <view class="move-btn {{index === 0 ? 'move-btn-disabled' : ''}}" data-index="{{index}}" data-dir="-1" catchtap="onMoveItem">
            <view class="icon icon-arrow-up"></view>
          </view>
          <view class="move-btn {{index === draft.length - 1 ? 'move-btn-disabled' : ''}}" data-index="{{index}}" data-dir="1" catchtap="onMoveItem">
            <view class="icon icon-arrow-down"></view>
          </view>
        </view>
        <text class="added-tag">{{item.muscleName}}</text>
        <view class="added-del" data-index="{{index}}" catchtap="onRemoveItem">
          <view class="icon icon-x"></view>
        </view>
      </view>
    </view>
    <view class="btn-ghost btn-ghost-add" bindtap="onBackToPick">
      <view class="icon icon-plus"></view>
      <text>继续添加动作</text>
    </view>
    <view class="note-wrap">
      <textarea
        class="note-input"
        value="{{note}}"
        bindinput="onNoteInput"
        placeholder="训练备注（可选）：今天状态如何？哪里练得好？"
        maxlength="200"
        auto-height
      ></textarea>
    </view>
  </view>

  <!-- 底部保存栏 -->
  <view class="footer" wx:if="{{draft.length > 0}}">
    <view class="footer-summary">
      <text class="num-accent footer-vol">{{totalVolume}} {{unitLabel}}</text>
      <text class="footer-sub">{{totalSets}} 组 · {{sessionMinutes}} 分钟</text>
    </view>
    <view class="save-btn" bindtap="onSave">保存训练</view>
  </view>
</view>
