<view class="page">
  <!-- 页头 -->
  <view class="header">
    <view class="header-left">
      <view class="date-row">
        <text class="date">{{todayDate}}</text>
        <text class="week-badge">{{todayWeek}}</text>
      </view>
      <view class="sub">今天练了什么？记录下来</view>
    </view>
    <view class="header-right">
      <view class="history-entry" bindtap="onGoPlans">
        <text>计划</text>
        <view class="history-arrow"></view>
      </view>
      <view class="history-entry" bindtap="onGoHistory">
        <text>历史</text>
        <view class="history-arrow"></view>
      </view>
    </view>
  </view>

  <!-- 本周计划今日提醒 -->
  <view class="plan-reminder" wx:if="{{planReminder}}" hover-class="plan-reminder-hover" bindtap="onFillReminder">
    <view class="plan-reminder-left">
      <text class="plan-reminder-title">{{planReminder.planName}} · 今日训练日 {{planReminder.dayName}}</text>
      <text class="plan-reminder-sub">本周计划 · 点击一键填充</text>
    </view>
    <view class="plan-reminder-btn">开始</view>
  </view>

  <!-- 训练计时 -->
  <view class="timer-bar" wx:if="{{sessionStarted}}">
    <view class="timer-dot {{sessionPaused ? 'timer-dot-paused' : ''}}"></view>
    <text class="timer-text">{{sessionPaused ? '已暂停' : '本次训练已进行'}} {{sessionMinutes}} 分钟<text wx:if="{{sessionPaused && pausedMinutes > 0}}" class="timer-paused-sub"> · 已暂停 {{pausedMinutes}} 分钟</text></text>
    <view class="timer-pause" bindtap="onTogglePause">
      <view class="icon {{sessionPaused ? 'icon-play' : 'icon-pause'}}"></view>
    </view>
  </view>

  <!-- 组间休息倒计时 -->
  <view class="rest-bar" wx:if="{{restRunning || restRemaining > 0}}">
    <view class="rest-left">
      <text class="rest-num {{restAlmostDone ? 'rest-num-almost' : ''}}">{{restRemaining}}</text>
      <text class="rest-unit">秒</text>
    </view>
    <view class="rest-right">
      <view class="rest-chip" data-secs="30" bindtap="onRestStart">30s</view>
      <view class="rest-chip" data-secs="60" bindtap="onRestStart">60s</view>
      <view class="rest-chip" data-secs="90" bindtap="onRestStart">90s</view>
      <view class="rest-chip" data-secs="120" bindtap="onRestStart">120s</view>
      <view class="rest-stop" bindtap="stopRestTimer">停止</view>
    </view>
  </view>

  <!-- 休息计时快捷入口（未计时时显示，含自定义秒数） -->
  <view class="rest-quick" wx:if="{{!restRunning && restRemaining === 0}}">
    <text class="rest-quick-label">组间休息</text>
    <view class="rest-chip rest-chip-dark" data-secs="30" bindtap="onRestStart">30s</view>
    <view class="rest-chip rest-chip-dark" data-secs="60" bindtap="onRestStart">60s</view>
    <view class="rest-chip rest-chip-dark" data-secs="90" bindtap="onRestStart">90s</view>
    <view class="rest-chip rest-chip-dark" data-secs="120" bindtap="onRestStart">120s</view>
    <input
      class="rest-custom-input"
      type="number"
      value="{{restCustomSecs}}"
      bindinput="onRestCustomInput"
      placeholder="秒"
    />
    <view class="rest-custom-go" bindtap="onRestCustomStart">开始</view>
  </view>

  <!-- 选部位 + 选动作 -->
  <view class="card" wx:if="{{step === 'pick'}}">
    <view class="search-mini">
      <input
        class="search-mini-input"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        placeholder="搜索动作快速添加"
        confirm-type="search"
      />
      <view wx:if="{{searchKeyword}}" class="search-clear" bindtap="onClearSearch">
        <view class="icon icon-x"></view>
      </view>
    </view>

    <block wx:if="{{!searchKeyword}}">
      <view class="card-title" style="margin-top: 20rpx;">选择训练部位</view>
      <view class="muscle-row">
        <view
          wx:for="{{muscles}}"
          wx:key="key"
          class="muscle-chip {{currentMuscle === item.key ? 'chip-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onPickMuscle"
        >
          <text class="muscle-icon">{{item.icon}}</text>
          <text>{{item.name}}</text>
        </view>
      </view>
      <view class="lib-entry" hover-class="lib-entry-hover" bindtap="onGoLibrary">
        <view class="lib-entry-left">
          <text class="lib-entry-title">在动作库查看「{{currentMuscleName}}」全部动作</text>
          <text class="lib-entry-sub">含动作详情 · 部位训练指南</text>
        </view>
        <view class="lib-entry-arrow"></view>
      </view>
      <view class="section-head" style="margin-top: 24rpx;">
        <text class="card-title" style="margin:0;">选择动作</text>
        <text class="section-count">{{exerciseList.length}}</text>
      </view>
      <view class="exercise-grid">
        <view
          wx:for="{{exerciseList}}"
          wx:key="id"
          class="exercise-item"
          data-id="{{item.id}}"
          bindtap="onAddExercise"
        >
          <text class="exercise-name">{{item.name}}</text>
          <text wx:if="{{item.lastText}}" class="exercise-last">{{item.lastText}}</text>
          <view class="exercise-dots">
            <view class="dot {{item.difficulty >= 1 ? 'dot-on' : ''}}"></view>
            <view class="dot {{item.difficulty >= 2 ? 'dot-on' : ''}}"></view>
            <view class="dot {{item.difficulty >= 3 ? 'dot-on' : ''}}"></view>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="card-title" style="margin-top: 20rpx;">搜索结果（{{exerciseList.length}}）</view>
      <view class="exercise-grid">
        <view
          wx:for="{{exerciseList}}"
          wx:key="id"
          class="exercise-item"
          data-id="{{item.id}}"
          bindtap="onAddExercise"
        >
          <text class="exercise-name">{{item.name}}</text>
          <text wx:if="{{item.lastText}}" class="exercise-last">{{item.lastText}}</text>
          <view class="exercise-dots">
            <view class="dot {{item.difficulty >= 1 ? 'dot-on' : ''}}"></view>
            <view class="dot {{item.difficulty >= 2 ? 'dot-on' : ''}}"></view>
            <view class="dot {{item.difficulty >= 3 ? 'dot-on' : ''}}"></view>
          </view>
        </view>
      </view>
      <view class="btn-ghost" bindtap="onClearSearch">清除搜索，返回部位选择</view>
    </block>
  </view>

  <!-- 组编辑卡片（set-editor 组件） -->
  <set-editor
    wx:if="{{step === 'edit'}}"
    exercise-name="{{editing.exerciseName}}"
    muscle-name="{{editingMuscleName}}"
    sets="{{editing.sets}}"
    last-prefill="{{editing.lastPrefillText}}"
    bind:togglewarmup="onToggleWarmup"
    bind:weightinput="onWeightInput"
    bind:repsinput="onRepsInput"
    bind:rpeinput="onRpeInput"
    bind:removeset="onRemoveSet"
    bind:addset="onAddSet"
    bind:done="onDoneEdit"
    bind:close="onBackToPick"
    bind:clearprefill="onClearPrefill"
  />

  <!-- 本次已添加动作 -->
  <view class="card" wx:if="{{draft.length > 0}}">
    <view class="draft-head">
      <view class="card-title" style="margin:0;">本次训练</view>
      <text class="draft-count">{{draft.length}} 个动作</text>
    </view>
    <view
      wx:for="{{draft}}"
      wx:key="exerciseId"
      class="added-row"
      data-index="{{index}}"
      bindtap="onEditItem"
    >
      <view class="added-index">{{index + 1}}</view>
      <view class="added-info">
        <text class="added-name">{{item.exerciseName}}</text>
        <text class="added-sub">{{item.sets.length}} 组 · 容量 {{itemVolumes[index]}} kg</text>
      </view>
      <view class="added-right">
        <view class="added-move">
          <view class="move-btn {{index === 0 ? 'move-btn-disabled' : ''}}" data-index="{{index}}" data-dir="-1" catchtap="onMoveItem">
            <view class="icon icon-arrow-up"></view>
          </view>
          <view class="move-btn {{index === draft.length - 1 ? 'move-btn-disabled' : ''}}" data-index="{{index}}" data-dir="1" catchtap="onMoveItem">
            <view class="icon icon-arrow-down"></view>
          </view>
        </view>
        <text class="added-tag">{{item.muscleName}}</text>
        <view class="added-del" data-index="{{index}}" catchtap="onRemoveItem">
          <view class="icon icon-x"></view>
        </view>
      </view>
    </view>
    <view class="btn-ghost btn-ghost-add" bindtap="onBackToPick">
      <view class="icon icon-plus"></view>
      <text>继续添加动作</text>
    </view>
    <view class="note-wrap">
      <textarea
        class="note-input"
        value="{{note}}"
        bindinput="onNoteInput"
        placeholder="训练备注（可选）：今天状态如何？哪里练得好？"
        maxlength="200"
        auto-height
      ></textarea>
    </view>
  </view>

  <!-- 底部保存栏 -->
  <view class="footer" wx:if="{{draft.length > 0}}">
    <view class="footer-summary">
      <text class="num-accent footer-vol">{{totalVolume}} kg</text>
      <text class="footer-sub">{{totalSets}} 组 · {{sessionMinutes}} 分钟</text>
    </view>
    <view class="save-btn" bindtap="onSave">保存训练</view>
  </view>
</view>
