.page {
  padding-bottom: 80rpx;
}

/* 部位切换 tab */
.muscle-tabs {
  white-space: nowrap;
  padding: 20rpx 24rpx 0;
}

.tab {
  display: inline-block;
  padding: 14rpx 28rpx;
  margin-right: 14rpx;
  background: #ffffff;
  border: 1rpx solid #f1f2f4;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #6b7280;
  transition: all 0.15s;
}

.tab-active {
  background: #1d1d1f;
  border-color: #1d1d1f;
  color: #ffffff;
  font-weight: 500;
}

/* 部位头部 */
.m-head {
  margin: 28rpx 32rpx 8rpx;
}

.m-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: 0.5rpx;
}

.m-freq {
  font-size: 23rpx;
  color: #9ca3af;
  margin-top: 8rpx;
  line-height: 1.6;
}

.m-tips {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 1rpx 3rpx rgba(17, 24, 39, 0.04), 0 8rpx 24rpx rgba(17, 24, 39, 0.03);
}

.m-tip-row {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
}

.m-tip-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #4f46e5;
  margin: 14rpx 16rpx 0 0;
  flex-shrink: 0;
}

.m-tip-text {
  font-size: 24rpx;
  color: #374151;
  line-height: 1.7;
}

/* 分区卡 */
.group-card {
  padding: 28rpx 32rpx;
  margin: 20rpx 32rpx;
}

.group-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.group-left {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.group-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.group-rec {
  font-size: 21rpx;
  color: #4f46e5;
  margin-top: 8rpx;
  background: #eef2ff;
  border-radius: 10rpx;
  padding: 6rpx 16rpx;
  display: inline-block;
  align-self: flex-start;
}

.group-count {
  font-size: 21rpx;
  color: #9ca3af;
  background: #f3f4f6;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.group-tips {
  margin-top: 16rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
}

.group-tip-row {
  display: flex;
  align-items: flex-start;
  padding: 4rpx 0;
}

.group-tip-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #c4c8cf;
  margin: 12rpx 12rpx 0 0;
  flex-shrink: 0;
}

.group-tip-text {
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.6;
}

.group-ex {
  display: flex;
  align-items: center;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid #f9fafb;
}

.group-ex:last-child {
  border-bottom: none;
}

.group-ex-hover {
  background: #f7f7f8;
  border-radius: 12rpx;
}

.group-ex-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.group-ex-name {
  font-size: 27rpx;
  color: #1d1d1f;
  font-weight: 500;
}

.group-ex-meta {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-right: 16rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #e8eaed;
}

.dot-on {
  background: #1d1d1f;
}

.group-ex-arrow {
  color: #d1d5db;
  font-size: 30rpx;
}

.empty-tip {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 100rpx 40rpx;
}
