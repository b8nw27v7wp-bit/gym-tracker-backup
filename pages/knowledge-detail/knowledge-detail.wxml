<view class="page" wx:if="{{article}}">
  <view class="hero">
    <view class="hero-cat">{{article.catName}}</view>
    <view class="hero-title">{{article.title}}</view>
    <view class="hero-summary">{{article.summary}}</view>
  </view>

  <view class="body">
    <view wx:for="{{article.sections}}" wx:key="h" class="section">
      <view class="section-h">{{item.h}}</view>
      <view wx:if="{{item.type === 'para'}}" class="section-para">{{item.content}}</view>
      <view wx:if="{{item.type === 'list'}}" class="section-list">
        <view wx:for="{{item.items}}" wx:for-item="li" wx:key="*this" class="list-row">
          <text class="list-dot">•</text>
          <text class="list-text">{{li}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="end-note">坚持记录，比任何计划都重要</view>

  <!-- v2.28.1：学完就练（文章→训练联动） -->
  <view class="action-card" wx:if="{{related.length > 0}}">
    <view class="action-title">📌 学完就练</view>
    <view
      wx:for="{{related}}"
      wx:key="id"
      class="action-row"
      data-id="{{item.id}}"
      bindtap="onGoTrain"
    >
      <text class="action-name">{{item.name}}</text>
      <text class="action-go">去记录 ›</text>
    </view>
  </view>
</view>
