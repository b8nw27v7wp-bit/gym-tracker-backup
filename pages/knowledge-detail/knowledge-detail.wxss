.page {
  padding-bottom: 80rpx;
}

.hero {
  padding: 48rpx 40rpx 8rpx;
}

.hero-cat {
  display: inline-block;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 22rpx;
  border-radius: 10rpx;
  padding: 6rpx 18rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
  margin-top: 20rpx;
}

.hero-summary {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.7;
  margin-top: 14rpx;
}

.body {
  padding: 8rpx 40rpx;
}

.section {
  margin-top: 36rpx;
}

.section-h {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
}

.section-para {
  font-size: 27rpx;
  color: #374151;
  line-height: 1.9;
}

.section-list {
  margin-top: 4rpx;
}

.list-row {
  display: flex;
  padding: 10rpx 0;
}

.list-dot {
  color: #111827;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.list-text {
  flex: 1;
  font-size: 27rpx;
  color: #374151;
  line-height: 1.8;
}

.end-note {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 60rpx;
}
