.page {
  padding-bottom: 60rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #6b7280;
}

.info-value {
  font-size: 26rpx;
  color: #111827;
  font-weight: 500;
}

.storage-tip {
  margin-top: 14rpx;
  background: #fef3c7;
  color: #92400e;
  border-radius: 12rpx;
  font-size: 23rpx;
  padding: 14rpx 20rpx;
}

.about-text {
  font-size: 25rpx;
  color: #6b7280;
  line-height: 1.8;
}

.act-btn {
  margin-bottom: 20rpx;
}

.danger-btn {
  color: #ef4444;
  background: #fef2f2;
}

.link-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 4rpx;
  border-top: 1rpx solid #f9fafb;
  font-size: 26rpx;
  color: #374151;
}

.link-arrow {
  color: #d1d5db;
  font-size: 32rpx;
}
