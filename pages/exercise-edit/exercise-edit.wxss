.page {
  padding-bottom: 180rpx;
}

.required {
  color: #ef4444;
}

.form-input {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-top: 8rpx;
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-top: 8rpx;
}

.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-top: 8rpx;
}

.picker-label {
  font-size: 28rpx;
  color: #1d1d1f;
}

.picker-arrow {
  color: #d1d5db;
  font-size: 32rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 12rpx;
}

.target-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.target-tag {
  display: inline-flex;
  align-items: center;
  background: #f3f4f6;
  color: #374151;
  border-radius: 12rpx;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.target-tag-del {
  margin-left: 10rpx;
  color: #9ca3af;
  font-size: 22rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 32rpx 40rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -2rpx 12rpx rgba(17, 24, 39, 0.04);
}

.save-btn {
  flex: 1;
  background: #1d1d1f;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 24rpx 0;
  text-align: center;
}

.del-btn {
  flex: 1;
  background: #fef2f2;
  color: #ef4444;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  text-align: center;
}
