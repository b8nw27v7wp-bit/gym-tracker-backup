.page {
  padding-bottom: 60rpx;
}

.head-right {
  display: flex;
  justify-content: flex-end;
  padding: 24rpx 40rpx 0;
}

.head-link {
  background: #ffffff;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #374151;
  padding: 10rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(17, 24, 39, 0.04);
}

.work-card {
  padding: 28rpx 32rpx;
}

.work-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.work-info {
  display: flex;
  flex-direction: column;
}

.work-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.work-sub {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.arrow {
  color: #d1d5db;
  font-size: 28rpx;
  padding: 12rpx;
}

.work-detail {
  margin-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
  padding-top: 20rpx;
}

.work-note {
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.detail-ex {
  margin-bottom: 20rpx;
}

.detail-ex-name {
  font-size: 27rpx;
  font-weight: 500;
  color: #111827;
  margin-bottom: 10rpx;
}

.detail-ex-note {
  font-size: 21rpx;
  font-weight: 400;
  color: #9ca3af;
  margin-left: 12rpx;
}

.detail-sets {
  display: flex;
  flex-wrap: wrap;
}

.detail-set {
  background: #f9fafb;
  border-radius: 10rpx;
  font-size: 23rpx;
  color: #6b7280;
  padding: 8rpx 18rpx;
  margin-right: 14rpx;
  margin-bottom: 10rpx;
}

.detail-set-warm {
  background: #ffedd5;
  color: #ea580c;
}

.danger-btn {
  margin-top: 10rpx;
  color: #ef4444;
  background: #fef2f2;
}
