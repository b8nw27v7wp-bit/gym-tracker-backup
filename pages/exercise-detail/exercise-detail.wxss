.page {
  padding-bottom: 160rpx;
}

.hero {
  padding: 48rpx 40rpx 16rpx;
}

.hero-name {
  font-size: 52rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.hero-tags {
  margin-top: 16rpx;
}

.hero-tag {
  display: inline-block;
  background: #ffffff;
  color: #374151;
  border-radius: 12rpx;
  font-size: 23rpx;
  padding: 8rpx 20rpx;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 2rpx 12rpx rgba(17, 24, 39, 0.04);
}

/* 肌肉发力图（v2.14）：canvas 人体 + 肌群标签 */
.map-tags {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}

.map-tag-row {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0;
}

.map-tag-label {
  width: 90rpx;
  font-size: 23rpx;
  color: #9ca3af;
  flex-shrink: 0;
  padding-top: 6rpx;
}

.map-tags-wrap {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
}

.map-chip {
  border-radius: 10rpx;
  font-size: 23rpx;
  padding: 6rpx 16rpx;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
}

.map-chip-primary {
  background: #eef2ff;
  color: #4f46e5;
}

.map-chip-secondary {
  background: #f9fafb;
  color: #6b7280;
}

/* 步骤 */
.step-row {
  display: flex;
  padding: 14rpx 0;
}

.step-no {
  width: 48rpx;
  height: 48rpx;
  background: #1d1d1f;
  color: #ffffff;
  border-radius: 50%;
  font-size: 24rpx;
  text-align: center;
  line-height: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-text {
  flex: 1;
  font-size: 27rpx;
  color: #374151;
  line-height: 1.7;
}

/* 错误 */
.err-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.err-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fca5a5;
  margin: 14rpx 14rpx 0 0;
  flex-shrink: 0;
}

.err-text {
  flex: 1;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
}

/* 贴士 */
.tip-card {
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  box-shadow: none;
}

.tip-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.tip-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #a5b4fc;
  margin-right: 12rpx;
}

.tip-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #92400e;
}

.tip-text {
  font-size: 26rpx;
  color: #78350f;
  line-height: 1.7;
}

/* 部位训练知识 */
.m-freq {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 14rpx;
  line-height: 1.6;
}

.m-tip-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.m-tip-dot {
  color: #1d1d1f;
  font-size: 28rpx;
  margin-right: 14rpx;
  line-height: 1.6;
}

.m-tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #374151;
  line-height: 1.6;
}

/* 相关动作 / 关联阅读 */
.rel-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}

.rel-row:last-child {
  border-bottom: none;
}

.rel-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-right: 20rpx;
}

.rel-name {
  font-size: 27rpx;
  color: #1d1d1f;
  font-weight: 500;
}

.rel-summary {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
  line-height: 1.5;
}

.rel-arrow {
  color: #d1d5db;
  font-size: 34rpx;
}

/* 底部按钮 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(17, 24, 39, 0.05);
}

.save-btn {
  background: #1d1d1f;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 24rpx 0;
  text-align: center;
}

.save-btn:active {
  opacity: 0.85;
}

/* 替代动作推荐 */
.sub-hint {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 16rpx;
}

.sub-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.sub-row:last-child {
  border-bottom: none;
}

.sub-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-right: 20rpx;
}

.sub-name {
  font-size: 27rpx;
  color: #1d1d1f;
  font-weight: 500;
}

.sub-reason {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

/* v6：重量趋势图 */
.trend-hint {
  font-size: 21rpx;
  color: #9ca3af;
  margin-bottom: 12rpx;
}

.trend-canvas {
  width: 100%;
  height: 280rpx;
}

.trend-empty {
  padding: 32rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: #9ca3af;
}
